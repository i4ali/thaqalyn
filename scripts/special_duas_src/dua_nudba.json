"{\n \"url\": \"https://www.duas.org/dua-nudbah.html\",\n \"title\": \"Dua Nudba - Duas.org\",\n \"meta\": {\n  \"Type\": \"SUPPLICATION\",\n  \"Attributed to\": \"Imam Mahdi (atfs)\",\n  \"Recommended for\": \"Friday, Fajr, Eid-ul-Fitr, Eid-ul-Adha\",\n  \"Purpose\": \"Spiritual Elevation\"\n },\n \"segCount\": 364,\n \"missTR\": 1,\n \"missEN\": 1,\n \"totalArChars\": 13272,\n \"segments\": [\n  {\n   \"ar\": \"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ\",\n   \"tr\": \"\",\n   \"en\": \"\"\n  },\n  {\n   \"ar\": \"الْحَمْدُ لِلَّهِ رَبِّ ٱلْعَالَمِينَ\",\n   \"tr\": \"alhamdu lillahi rabbi al`alamina\",\n   \"en\": \"All praise be to Allah the Lord of the worlds.\"\n  },\n  {\n   \"ar\": \"وَصَلَّىٰ ٱللَّهُ عَلَىٰ سَيِّدِنَا مُحَمَّدٍ نَبِيِّهِ\",\n   \"tr\": \"wa salla allahu `ala sayyidina muhammadin nabiyyihi\",\n   \"en\": \"May Allah send blessings upon our master Muhammad His Prophet\"\n  },\n  {\n   \"ar\": \"وَآلِهِ وَسَلَّمَ تَسْلِيماً\",\n   \"tr\": \"wa alihi wa sallama tasliman\",\n   \"en\": \"and upon his Household and may He salute them with thorough salutation.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ لَكَ ٱلْحَمْدُ\",\n   \"tr\": \"allahumma laka alhamdu\",\n   \"en\": \"O Allah, all praise be to You\"\n  },\n  {\n   \"ar\": \"عَلَىٰ مَا جَرَىٰ بِهِ قَضَاؤُكَ\",\n   \"tr\": \"`ala ma jara bihi qada'uka\",\n   \"en\": \"for Your decree that has been applied\"\n  },\n  {\n   \"ar\": \"فِي اوْلِيَائِكَ ٱلَّذِينَ ٱسْتَخْلَصْتَهُمْ لِنَفْسِكَ وَدِينِكَ\",\n   \"tr\": \"fi awliya'ika alladhina istakhlastahum linafsika wa dinika\",\n   \"en\": \"to Your vicegerents whom You have purely selected for Yourself and Your religion;\"\n  },\n  {\n   \"ar\": \"إِِذِ ٱخْتَرْتَ لَهُمْ جَزِيلَ مَا عِنْدَكَ\",\n   \"tr\": \"idhi ikhtarta lahum jazila ma `indaka\",\n   \"en\": \"as You have chosen for them the abundance of what You have in possession;\"\n  },\n  {\n   \"ar\": \"مِنَ ٱلنَّعِيمِ ٱلْمُقِيمِ\",\n   \"tr\": \"min alnna`imi almuqimi\",\n   \"en\": \"that is the enduring pleasure\"\n  },\n  {\n   \"ar\": \"ٱلَّذِي لاََ زَوَالَ لَهُ وَلاَ ٱضْمِحْلاَلَ\",\n   \"tr\": \"alladhi la zawala lahu wa la idmihlala\",\n   \"en\": \"that neither vanishes nor diminishes,\"\n  },\n  {\n   \"ar\": \"بَعْدَ انْ شَرَطْتَ عَلَيْهِمُ ٱلزُّهْدَ\",\n   \"tr\": \"ba`da an sharatta `alayhim alzzuhda\",\n   \"en\": \"after You had already stipulated on them to renounce\"\n  },\n  {\n   \"ar\": \"فِي دَرَجَاتِ هٰذِهِ ٱلدُّنْيَا ٱلدَّنِيَّةِ\",\n   \"tr\": \"fi darajati hadhihi alddunya alddaniyyati\",\n   \"en\": \"all the ranks of this lowly world\"\n  },\n  {\n   \"ar\": \"وَزُخْرُفِهَا وَزِبْرِجِهَا\",\n   \"tr\": \"wa zukhrufiha wa zibrijiha\",\n   \"en\": \"along with all of its embellishments and ornaments,\"\n  },\n  {\n   \"ar\": \"فَشَرَطُوٱ لَكَ ذٰلِكَ\",\n   \"tr\": \"fasharatu laka dhalika\",\n   \"en\": \"and they accepted this stipulation.\"\n  },\n  {\n   \"ar\": \"وَعَلِمْتَ مِنْهُمُ ٱلْوَفَاءَ بِهِ\",\n   \"tr\": \"wa `alimta minhum alwafa'a bihi\",\n   \"en\": \"As You knew that they would fulfill this stipulation,\"\n  },\n  {\n   \"ar\": \"فَقَبِلْتَهُمْ وَقَرَّبْتَهُمْ\",\n   \"tr\": \"faqabiltahum wa qarrabtahum\",\n   \"en\": \"You accepted and drew them near to You.\"\n  },\n  {\n   \"ar\": \"وَقَدَّمْتَ لَهُمُ ٱلذِّكْرَ ٱلْعَلِيَّ\",\n   \"tr\": \"wa qaddamta lahum aldhdhikra al`aliyya\",\n   \"en\": \"You thus provided them with sublime mention\"\n  },\n  {\n   \"ar\": \"وَٱلثَّنَاءَ ٱلْجَلِيَّ\",\n   \"tr\": \"walththana'a aljaliyya\",\n   \"en\": \"and obvious approval,\"\n  },\n  {\n   \"ar\": \"وَاهْبَطْتَ عَلَيْهِمْ مَلاَئِكَتَكَ\",\n   \"tr\": \"wa ahbatta `alayhim mala'ikataka\",\n   \"en\": \"made Your angels descend to them,\"\n  },\n  {\n   \"ar\": \"وَكَرَّمْتَهُمْ بِوَحْيِكَ\",\n   \"tr\": \"wa karramtahum biwahyika\",\n   \"en\": \"honored them with Your revelations,\"\n  },\n  {\n   \"ar\": \"وَرَفَدْتَهُمْ بِعِلْمِكَ\",\n   \"tr\": \"wa rafadtahum bi`ilmika\",\n   \"en\": \"supported them with Your knowledge,\"\n  },\n  {\n   \"ar\": \"وَجَعَلْتَهُمُ ٱلذَّرِيعَةَ إِِلَيْكَ\",\n   \"tr\": \"wa ja`altahum aldhdhari`ata ilayka\",\n   \"en\": \"and made them the channel to You\"\n  },\n  {\n   \"ar\": \"وَٱلْوَسِيلَةَ إِلَىٰ رِضْوَانِكَ\",\n   \"tr\": \"walwasilata ila ridwanika\",\n   \"en\": \"and the means to winning Your pleasure.\"\n  },\n  {\n   \"ar\": \"فَبَعْضٌ اسْكَنْتَهُ جَنَّتَكَ\",\n   \"tr\": \"faba`dun askantahu jannataka\",\n   \"en\": \"Therefore, You made some of them dwell in Your Garden\"\n  },\n  {\n   \"ar\": \"إِلَىٰ انْ اخْرَجْتَهُ مِنْهَا\",\n   \"tr\": \"ila an akhrajtahu minha\",\n   \"en\": \"until You decided to take him out of there.\"\n  },\n  {\n   \"ar\": \"وَبَعْضٌ حَمَلْتَهُ فِي فُلْكِكَ\",\n   \"tr\": \"wa ba`dun hamaltahu fi fulkika\",\n   \"en\": \"You bore another one on in Your Ark\"\n  },\n  {\n   \"ar\": \"وَنَجَّيْتَهُ وَمَنْ آمَنَ مَعَهُ\",\n   \"tr\": \"wa najjaytahu wa man amana ma`ahu\",\n   \"en\": \"and saved him and those who believed with him\"\n  },\n  {\n   \"ar\": \"مِنَ ٱلْهَلَكَةِ بِرَحْمَتِكَ\",\n   \"tr\": \"min alhalakati birahmatika\",\n   \"en\": \"from perdition, out of Your mercy.\"\n  },\n  {\n   \"ar\": \"وَبَعْضٌ ٱتَّخَذْتَهُ لِنَفْسِكَ خَلِيلاًَ\",\n   \"tr\": \"wa ba`dun ittakhadhtahu linafsika khalilan\",\n   \"en\": \"You took another one as Your intimate friend\"\n  },\n  {\n   \"ar\": \"وَسَالَكَ لِسَانَ صِدْقٍ فِي ٱلآخِرِينَ فَاجَبْتَهُ\",\n   \"tr\": \"wa sa'alaka lisana sidqin fi al-akhirina fa'ajabtahu\",\n   \"en\": \"and when he asked You to leave behind him a truthful mention, You responded to him\"\n  },\n  {\n   \"ar\": \"وَجَعَلْتَ ذٰلِكَ عَلِيّاً\",\n   \"tr\": \"wa ja`alta dhalika `aliyyan\",\n   \"en\": \"and made that (mention) to be eminent.\"\n  },\n  {\n   \"ar\": \"وَبَعْضٌ كَلَّمْتَهُ مِنْ شَجَرَةٍ تَكْلِيماً\",\n   \"tr\": \"wa ba`dun kallamtahu min shajaratin takliman\",\n   \"en\": \"You spoke to another one from a tree directly\"\n  },\n  {\n   \"ar\": \"وَجَعَلْتَ لَهُ مِنْ اخِيهِ رِدْءاً وَوَزِيراً\",\n   \"tr\": \"wa ja`alta lahu min akhihi rid'an wa waziran\",\n   \"en\": \"and decided his brother to be his protector and representative.\"\n  },\n  {\n   \"ar\": \"وَبَعْضٌ اوْلَدْتَهُ مِنْ غَيْرِ ابٍ\",\n   \"tr\": \"wa ba`dun awladtahu min ghayri abin\",\n   \"en\": \"You made another one to be born without a father,\"\n  },\n  {\n   \"ar\": \"وَآتَيْتَهُ ٱلْبَيِّنَاتِ\",\n   \"tr\": \"wa ataytahu albayyinati\",\n   \"en\": \"gave him clear-cut proofs\"\n  },\n  {\n   \"ar\": \"وَايَّدْتَهُ بِرُوحِ ٱلْقُدُسِ\",\n   \"tr\": \"wa ayyadtahu biruhi alqudusi\",\n   \"en\": \"and aided him with the Sacred Spirit.\"\n  },\n  {\n   \"ar\": \"وَكُلٌّ شَرَعْتَ لَهُ شَرِيعَةً\",\n   \"tr\": \"wa kullun shara`ta lahu shari`atan\",\n   \"en\": \"For each of them, You gave a code of law,\"\n  },\n  {\n   \"ar\": \"وَنَهَجْتَ لَهُ مِنْهَاجاً\",\n   \"tr\": \"wa nahajta lahu minhajan\",\n   \"en\": \"decided a certain course,\"\n  },\n  {\n   \"ar\": \"وَتَخَيَّرْتَ لَهُ اوْصِيَاءَ\",\n   \"tr\": \"wa takhayyarta lahu awsiya'a\",\n   \"en\": \"and finely chose successors;\"\n  },\n  {\n   \"ar\": \"مُسْتَحْفِظاً بَعْدَ مُسْتَحْفِظٍ\",\n   \"tr\": \"mustahfizan ba`da mustahfizin\",\n   \"en\": \"well-trustworthy successors one after another,\"\n  },\n  {\n   \"ar\": \"مِنْ مُدَّةٍ إِلَىٰ مُدَّةٍ\",\n   \"tr\": \"min muddatin ila muddatin\",\n   \"en\": \"each for a certain period,\"\n  },\n  {\n   \"ar\": \"إِِقَامَةً لِدِينِكَ\",\n   \"tr\": \"iqamatan lidinika\",\n   \"en\": \"in purpose of establishing Your religion\"\n  },\n  {\n   \"ar\": \"وَحُجَّةً عَلَىٰ عِبَادِكَ\",\n   \"tr\": \"wa hujjatan `ala `ibadika\",\n   \"en\": \"and acting as arguments against Your servants,\"\n  },\n  {\n   \"ar\": \"وَلِئَلاَّ يَزُولَ ٱلْحَقُّ عَنْ مَقَرِّهِ\",\n   \"tr\": \"wa li'alla yazula alhaqqu `an maqarrihi\",\n   \"en\": \"so that the truth should never leave its position\"\n  },\n  {\n   \"ar\": \"وَيَغْلِبَ ٱلْبَاطِلُ عَلَىٰ اهْلِهِ\",\n   \"tr\": \"wa yaghliba albatilu `ala ahlihi\",\n   \"en\": \"and the wrong should never overcome the people of the truth\"\n  },\n  {\n   \"ar\": \"وَلاَ يَقُولَ احَدٌ\",\n   \"tr\": \"wa la yaqula ahadun\",\n   \"en\": \"and so that none should claim, saying,\"\n  },\n  {\n   \"ar\": \"لَوْ لاَ ارْسَلْتَ إِِلَيْنَا رَسُولاًَ مُنْذِراً\",\n   \"tr\": \"lawla arsalta ilayna rasulan mundhiran\",\n   \"en\": \"“If only You had sent to us a warning messenger\"\n  },\n  {\n   \"ar\": \"وَاقَمْتَ لَنَا عَلَماً هَادِياً\",\n   \"tr\": \"wa aqamta lana `alaman hadiyan\",\n   \"en\": \"and established for us a guiding person,\"\n  },\n  {\n   \"ar\": \"فَنَتَّبِعَ آيَاتِكَ مِنْ قَبْلِ انْ نَذِلَّ وَنَخْزَىٰ\",\n   \"tr\": \"fanattabi`a ayatika min qabli an nadhilla wa nakhza\",\n   \"en\": \"we should have followed Your signs before that we met humiliation and disgrace!”\"\n  },\n  {\n   \"ar\": \"إِلَىٰ انِ ٱنْتَهَيْتَ بِٱلامْرِ إِلَىٰ حَبِيبِكَ وَنَجِيبِكَ مُحَمَّدٍ\",\n   \"tr\": \"ila an intahayta bil-amri ila habibika wa najibika muhammadin\",\n   \"en\": \"You then ended the matter with Your most-beloved and well-select one, Muhammad,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"may Allah bless him and his Household.\"\n  },\n  {\n   \"ar\": \"فَكَانَ كَمَا ٱنْتَجَبْتَهُ\",\n   \"tr\": \"fakana kama intajabtahu\",\n   \"en\": \"He was—as exactly as You have chosen—\"\n  },\n  {\n   \"ar\": \"سَيِّدَ مَنْ خَلَقْتَهُ\",\n   \"tr\": \"sayyida man khalaqtahu\",\n   \"en\": \"the master of all those whom You created,\"\n  },\n  {\n   \"ar\": \"وَصَفْوَةَ مَنِ ٱصْطَفَيْتَهُ\",\n   \"tr\": \"wa safwata man istafaytahu\",\n   \"en\": \"the best of all those whom You selected,\"\n  },\n  {\n   \"ar\": \"وَافْضَلَ مَنِ ٱجْتَبَيْتَهُ\",\n   \"tr\": \"wa afdala man ijtabaytahu\",\n   \"en\": \"the most favorite of all those whom You pointed out,\"\n  },\n  {\n   \"ar\": \"وَاكْرَمَ مَنِ ٱعْتَمَدْتَهُ\",\n   \"tr\": \"wa akrama man i`tamadtahu\",\n   \"en\": \"and the noblest of all those on whom You decided.\"\n  },\n  {\n   \"ar\": \"قَدَّمْتَهُ عَلَىٰ انْبِيَائِكَ\",\n   \"tr\": \"qaddamtahu `ala anbiya'ika\",\n   \"en\": \"So, You preferred him to Your prophets,\"\n  },\n  {\n   \"ar\": \"وَبَعَثْتَهُ إِِلَىٰ ٱلثَّقَلَيْنِ مِنْ عِبَادِكَ\",\n   \"tr\": \"wa ba`athtahu ila alththaqalayni min `ibadika\",\n   \"en\": \"sent him to the two dependents (men and jinn) from Your servants,\"\n  },\n  {\n   \"ar\": \"وَاوْطَاتَهُ مَشَارِقَكَ وَمَغَارِبَكَ\",\n   \"tr\": \"wa awta'tahu mashariqaka wa magharibaka\",\n   \"en\": \"enabled him to tread on the east and the west of Your lands,\"\n  },\n  {\n   \"ar\": \"وَسَخَّرْتَ لَهُ ٱلْبُرَاقَ\",\n   \"tr\": \"wa sakhkharta lahu alburaqa\",\n   \"en\": \"made subservient to him the Buraq (the celestial sumpter),\"\n  },\n  {\n   \"ar\": \"وَعَرَجْتَ بِهِ إِلَىٰ سَمَائِكَ\",\n   \"tr\": \"wa `arajta bihi ila sama'ika\",\n   \"en\": \"raised him to Your heavens,\"\n  },\n  {\n   \"ar\": \"وَاوْدَعْتَهُ عِلْمَ مَا كَانَ\",\n   \"tr\": \"wa awda`tahu `ilma ma kana\",\n   \"en\": \"and entrusted with him the knowledge of whatever passed\"\n  },\n  {\n   \"ar\": \"وَمَا يَكُونُ إِِلَىٰ ٱنْقِضَاءِ خَلْقِكَ\",\n   \"tr\": \"wa ma yakunu ila inqida'i khalqika\",\n   \"en\": \"and whatever shall come to pass up to the extinction of Your creatures.\"\n  },\n  {\n   \"ar\": \"ثُمَّ نَصَرْتَهُ بِٱلرُّعْبِ\",\n   \"tr\": \"thumma nasartahu bilrru`bi\",\n   \"en\": \"You then granted him victory by means of awe & majesty\"\n  },\n  {\n   \"ar\": \"وَحَفَفْتَهُ بِجَبْرَئِيلَ وَمِيكَائِيلَ\",\n   \"tr\": \"wa hafaftahu bijabra'ila wa mika'ila\",\n   \"en\": \"ordered (Archangels) Gabriel and Michael\"\n  },\n  {\n   \"ar\": \"وَٱلْمُسَوِّمِينَ مِنْ مَلاَئِكَتِكَ\",\n   \"tr\": \"walmusawwimina min mala'ikatika\",\n   \"en\": \"as well as the marked angels to surround him,\"\n  },\n  {\n   \"ar\": \"وَوَعَدْتَهُ انْ تُظْهِرَ دِينَهُ عَلَىٰ ٱلدِّينِ كُلِّهِ\",\n   \"tr\": \"wa wa`adtahu an tuzhira dinahu `ala alddini kullihi\",\n   \"en\": \"and promised him to make his faith prevail all other faiths\"\n  },\n  {\n   \"ar\": \"وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ\",\n   \"tr\": \"wa law kariha almushrikuna\",\n   \"en\": \"however much the polytheists may be averse.\"\n  },\n  {\n   \"ar\": \"وَذٰلِكَ بَعْدَ انْ بَوَّاتَهُ مُبَوَّا صِدْقٍ مِنْ اهْلِهِ\",\n   \"tr\": \"wa dhalika ba`da an bawwa'tahu mubawwa'a sidqin min ahlihi\",\n   \"en\": \"You did all that after You had settled him in an honest position among his people,\"\n  },\n  {\n   \"ar\": \"وَجَعَلْتَ لَهُ وَلَهُمْ اوَّلَ بَيْتٍ\",\n   \"tr\": \"wa ja`alta lahu wa lahum awwala baytin\",\n   \"en\": \"made for him and them the first house\"\n  },\n  {\n   \"ar\": \"وُضِعَ لِلنَّاسِ لَلَّذي بِبَكَّةَ\",\n   \"tr\": \"wudi`a lilnnasi lalladhi bibakkata\",\n   \"en\": \"ever located for the people; that is the house in Bakkah,\"\n  },\n  {\n   \"ar\": \"مُبَارَكاً وَهُدىًٰ لِلْعَالَمينَ\",\n   \"tr\": \"mubarakan wa hudan lil`alamina\",\n   \"en\": \"blessed and guidance for the worlds.\"\n  },\n  {\n   \"ar\": \"فِيهِ آيَاتٌ بَيِّنَاتٌ\",\n   \"tr\": \"fihi ayatun bayyinatun\",\n   \"en\": \"In it, there are clear-cut proofs.\"\n  },\n  {\n   \"ar\": \"مَقَامُ إِِبْرَاهِيمَ\",\n   \"tr\": \"maqamu ibrahima\",\n   \"en\": \"It is the standing-place of Abraham,\"\n  },\n  {\n   \"ar\": \"وَمَنْ دَخَلَهُ كَانَ آمِناً\",\n   \"tr\": \"wa man dakhalahu kana aminan\",\n   \"en\": \"and whoever enters it will be secured.\"\n  },\n  {\n   \"ar\": \"وَقُلْتَ «إِِنَّمَا يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنْكُمُ ٱلرِّجْسَ\",\n   \"tr\": \"wa qulta innama yuridu allahu liyudhhiba `ankum alrrijsa\",\n   \"en\": \"You also said, “Allah only desires to keep away the uncleanness from you,\"\n  },\n  {\n   \"ar\": \"اهْلَ ٱلْبَيْتِ\",\n   \"tr\": \"ahla albayti\",\n   \"en\": \"O people of the House,\"\n  },\n  {\n   \"ar\": \"وَيُطَهِّرَكُمْ تَطْهِيراً.»\",\n   \"tr\": \"wa yutahhirakum tathiran\",\n   \"en\": \"and to purify you a thorough purifying.”\"\n  },\n  {\n   \"ar\": \"ثُمَّ جَعَلْتَ اجْرَ مُحَمَّدٍ\",\n   \"tr\": \"thumma ja`alta ajra muhammadin\",\n   \"en\": \"You then decided the reward of Muhammad,\"\n  },\n  {\n   \"ar\": \"صَلَوَاتُكَ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salawatuka `alayhi wa alihi\",\n   \"en\": \"Your blessings be upon him and his Household,\"\n  },\n  {\n   \"ar\": \"مَوَدَّتَهُمْ فِي كِتَابِكَ\",\n   \"tr\": \"mawaddatahum fi kitabika\",\n   \"en\": \"to be the love for them; as in Your Book\"\n  },\n  {\n   \"ar\": \"فَقُلْتَ «قُلْ لاََ اسْالُكُمْ عَلَيْهِ اجْراً\",\n   \"tr\": \"faqulta qul la as'alukum `alayhi ajran\",\n   \"en\": \"You said, “Say: I do not ask of you any reward for it\"\n  },\n  {\n   \"ar\": \"إِِلاَّ ٱلْمَوَدَّةَ فِي ٱلْقُرْبَىٰ.»\",\n   \"tr\": \"illa almawaddata fi alqurba\",\n   \"en\": \"but love for my near relatives.”\"\n  },\n  {\n   \"ar\": \"وَقُلْتَ «مَا سَالْتُكُمْ مِنْ اجْرٍ فَهُوَ لَكُمْ.»\",\n   \"tr\": \"wa qulta ma sa'altukum min ajrin fahuwa lakum\",\n   \"en\": \"You also said, “Whatever reward I have asked of you, that is only for yourselves.”\"\n  },\n  {\n   \"ar\": \"وَقُلْتَ «مَا اسْالُكُمْ عَلَيْهِ مِنْ اجْرٍ\",\n   \"tr\": \"wa qulta ma as'alukum `alayhi min ajrin\",\n   \"en\": \"You also said, “I do not ask you aught in return\"\n  },\n  {\n   \"ar\": \"إِلاَّ مَنْ شَاءَ انْ يَتَّخِذَ إِلَىٰ رَبِّهِ سَبِيلاًَ.»\",\n   \"tr\": \"illa man sha'a an yattakhidha ila rabbihi sabilan\",\n   \"en\": \"except that he who wills, may take the way to his Lord.”\"\n  },\n  {\n   \"ar\": \"فَكَانُوٱ هُمُ ٱلسَّبِيلَ إِِلَيْكَ\",\n   \"tr\": \"fakanu hum alssabila ilayka\",\n   \"en\": \"They (i.e. the Prophet’s Household) have therefore been the way to You\"\n  },\n  {\n   \"ar\": \"وَٱلْمَسْلَكَ إِلَىٰ رِضْوَانِكَ\",\n   \"tr\": \"walmaslaka ila ridwanika\",\n   \"en\": \"and the course to Your pleasure.\"\n  },\n  {\n   \"ar\": \"فَلَمَّا ٱنْقَضَتْ ايَّامُهُ\",\n   \"tr\": \"falamma inqadat ayyamuhu\",\n   \"en\": \"When his (i.e. the Prophet) days passed,\"\n  },\n  {\n   \"ar\": \"اقَامَ وَلِيَّهُ عَلِيَّ بْنَ ابِي طَالِبٍ\",\n   \"tr\": \"aqama waliyyahu `aliyya bna abi talibin\",\n   \"en\": \"he appointed as successor his vicegerent `Ali the son of Abu-Talib,\"\n  },\n  {\n   \"ar\": \"صَلَوَاتُكَ عَلَيْهِمَا وَآلِهِمَا هَادِياً\",\n   \"tr\": \"salawatuka `alayhima wa alihima hadiyan\",\n   \"en\": \"Your blessings be upon both of them and their Household,\"\n  },\n  {\n   \"ar\": \"إِِذْ كَانَ هُوَ ٱلْمُنْذِرَ\",\n   \"tr\": \"idh kana huwa almundhira\",\n   \"en\": \"because he (the Prophet) was the warner\"\n  },\n  {\n   \"ar\": \"وَلِكُلِّ قَوْمٍ هَادٍ\",\n   \"tr\": \"wa likulli qawmin hadin\",\n   \"en\": \"and `Ali was the guide for every people.\"\n  },\n  {\n   \"ar\": \"فَقَالَ وَٱلْمَلَا امَامَهُ:\",\n   \"tr\": \"faqala walmala'u amamahu\",\n   \"en\": \"So, he (the Prophet) said in the presence of the people,\"\n  },\n  {\n   \"ar\": \"”مَنْ كُنْتُ مَوْلاَهُ\",\n   \"tr\": \"man kuntu mawlahu\",\n   \"en\": \"“As for each one who has taken me as his master,\"\n  },\n  {\n   \"ar\": \"فَعَلِيٌّ مَوْلاَهُ\",\n   \"tr\": \"fa`aliyyun mawlahu\",\n   \"en\": \"`Ali is now his master.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ وَالِ مَنْ وَالاَهُ\",\n   \"tr\": \"allahumma wali man walahu\",\n   \"en\": \"O Allah, guard any one who is loyal to `Ali,\"\n  },\n  {\n   \"ar\": \"وَعَادِ مَنْ عَادَاهُ\",\n   \"tr\": \"wa `adi man `adahu\",\n   \"en\": \"be the enemy of any one who antagonizes him,\"\n  },\n  {\n   \"ar\": \"وَٱنْصُرْ مَنْ نَصَرَهُ\",\n   \"tr\": \"wansur man nasarahu\",\n   \"en\": \"support any one who supports him,\"\n  },\n  {\n   \"ar\": \"وَٱخْذُلْ مَنْ خَذَلَهُ.“\",\n   \"tr\": \"wakhdhul man khadhalahu\",\n   \"en\": \"and disappoint any one who disappoints him.”\"\n  },\n  {\n   \"ar\": \"وَقَالَ: ”مَنْ كُنْتُ انَا نَبِيَّهُ فَعَلِيٌّ امِيرُهُ.“\",\n   \"tr\": \"wa qala man kuntu ana nabiyyahu fa`aliyyun amiruhu\",\n   \"en\": \"He also said, “As for any one who has considered me as his Prophet, `Ali is now his commander.”\"\n  },\n  {\n   \"ar\": \"وَقَالَ: ”انَا وَعَلِيٌّ مِنْ شَجَرَةٍ وَاحِدَةٍ\",\n   \"tr\": \"wa qala ana wa `aliyyun min shajaratin wahidatin\",\n   \"en\": \"He also said, “`Ali and I are of the same tree,\"\n  },\n  {\n   \"ar\": \"وَسَائِرُ ٱلنَّاسِ مِنْ شَجَرٍ شَتَّىٰ.“\",\n   \"tr\": \"wa sa'iru alnnasi min shajarin shatta\",\n   \"en\": \"while all the other peoples are from various trees.”\"\n  },\n  {\n   \"ar\": \"وَاحَلَّهُ مَحَلَّ هَارُونَ مِنْ مُوسَىٰ\",\n   \"tr\": \"wa ahallahu mahalla haruna min musa\",\n   \"en\": \"He endued him (i.e. `Ali) with the position that (Prophet) Aaron had with regard to (Prophet) Moses,\"\n  },\n  {\n   \"ar\": \"فَقَالَ لَهُ: ”انْتَ مِنِّي بِمَنْزِلَةِ هَارُونَ مِنْ مُوسَىٰ\",\n   \"tr\": \"faqal lahu anta minni bimanzilati haruna min musa\",\n   \"en\": \"saying, “Your position to me is as same as Aaron’s position to Moses (in every thing)\"\n  },\n  {\n   \"ar\": \"إِلاَّ انَّهُ لاََ نَبِيَّ بَعْدِي.“\",\n   \"tr\": \"illa annahu la nabiyya ba`di\",\n   \"en\": \"except that there shall be no prophet after me.”\"\n  },\n  {\n   \"ar\": \"وَزَوَّجَهُ ٱبْنَتَهُ سَيِّدَةَ نِسَاءِ ٱلْعَالَمِينَ\",\n   \"tr\": \"wa zawwajahu ibnatahu sayyidata nisa'i al`alamina\",\n   \"en\": \"He gave him in marriage his daughter the doyenne of the women of the worlds.\"\n  },\n  {\n   \"ar\": \"وَاحَلَّ لَهُ مِنْ مَسْجِدِهِ مَا حَلَّ لَهُ\",\n   \"tr\": \"wa ahalla lahu min masjidihi ma halla lahu\",\n   \"en\": \"He allowed him (alone) to do whatever he himself is allowed to do in his Mosque.\"\n  },\n  {\n   \"ar\": \"وَسَدَّ ٱلابْوَابَ إِِلاَّ بَابَهُ\",\n   \"tr\": \"wa sadda al-abwaba illa babahu\",\n   \"en\": \"He closed all the doors (to the Mosque) except his (i.e. `Ali) door.\"\n  },\n  {\n   \"ar\": \"ثُمَّ اوْدَعَهُ عِلْمَهُ وَحِكْمَتَهُ\",\n   \"tr\": \"thumma awda`ahu `ilmahu wa hikmatahu\",\n   \"en\": \"He then entrusted with him his knowledge and his wisdom,\"\n  },\n  {\n   \"ar\": \"فَقَالَ: ”انَا مَدِينَةُ ٱلْعِلْمِ\",\n   \"tr\": \"faqala ana madinatu al`ilmi\",\n   \"en\": \"saying, “I am the city of knowledge,\"\n  },\n  {\n   \"ar\": \"وَعَلِيٌّ بَابُهَا\",\n   \"tr\": \"wa `aliyyun babuha\",\n   \"en\": \"and `Ali is its door.\"\n  },\n  {\n   \"ar\": \"فَمَنْ ارَادَ ٱلْمَدِينَةَ وَٱلْحِكْمَةَ\",\n   \"tr\": \"faman arada almadinata walhikmata\",\n   \"en\": \"So, whoever wants this city and wisdom,\"\n  },\n  {\n   \"ar\": \"فَلْيَاتِهَا مِنْ بَابِهَا.“\",\n   \"tr\": \"falya'tiha min babiha\",\n   \"en\": \"must come to it from its door.”\"\n  },\n  {\n   \"ar\": \"ثُمَّ قَالَ: ”انْتَ اخِي وَوَصِيِّي وَوَارِثِي\",\n   \"tr\": \"thumma qala anta akhi wa wasiyyi wa warithi\",\n   \"en\": \"He then said (to `Ali), “You are my brother, successor, and inheritor.\"\n  },\n  {\n   \"ar\": \"لَحْمُكَ مِنْ لَحْمِي\",\n   \"tr\": \"lahmuka min lahmi\",\n   \"en\": \"Your flesh is part of my flesh,\"\n  },\n  {\n   \"ar\": \"وَدَمُكَ مِنْ دَمِي\",\n   \"tr\": \"wa damuka min dami\",\n   \"en\": \"your blood is part of my blood,\"\n  },\n  {\n   \"ar\": \"وَسِلْمُكَ سِلْمِي\",\n   \"tr\": \"wa silmuka silmi\",\n   \"en\": \"your peace is my peace,\"\n  },\n  {\n   \"ar\": \"وَحَرْبُكَ حَرْبِي\",\n   \"tr\": \"wa harbuka harbi\",\n   \"en\": \"your war is my war,\"\n  },\n  {\n   \"ar\": \"وَٱلإِيـمَانُ مُخَالِطٌ لَحْمَكَ وَدَمَكَ\",\n   \"tr\": \"wal-imanu mukhalitun lahmaka wa damaka\",\n   \"en\": \"and faith is mixed with your flesh and blood\"\n  },\n  {\n   \"ar\": \"كَمَا خَالَطَ لَحْمِي وَدَمِي\",\n   \"tr\": \"kama khalata lahmi wa dami\",\n   \"en\": \"as same as it is mixed with my flesh and blood.\"\n  },\n  {\n   \"ar\": \"وَانْتَ غَداً عَلَىٰ الْحَوْضِ خَلِيفَتِي\",\n   \"tr\": \"wa anta ghadan `ala alhawdi khalifati\",\n   \"en\": \"On the morrow, you shall be my vicegerent on the (Divine) Pond.\"\n  },\n  {\n   \"ar\": \"وَانْتَ تَقْضِي دَيْنِي\",\n   \"tr\": \"wa anta taqdi dayni\",\n   \"en\": \"You also settle my debts\"\n  },\n  {\n   \"ar\": \"وَتُنْجِزُ عِدَاتِي\",\n   \"tr\": \"wa tunjizu `idati\",\n   \"en\": \"and fulfill my commitments.\"\n  },\n  {\n   \"ar\": \"وَشِيعَتُكَ عَلَىٰ مَنَابِرَ مِنْ نُورٍ\",\n   \"tr\": \"wa shi`atuka `ala manabira min nurin\",\n   \"en\": \"Your Shi`ah (i.e. adherents) shall be on pulpits of light,\"\n  },\n  {\n   \"ar\": \"مُبْيَضَّةً وُجُوهُهُمْ حَوْلِي فِي ٱلْجَنَّةِ\",\n   \"tr\": \"mubyaddatan wujuhuhum hawli fi aljannati\",\n   \"en\": \"white-faced, around me in Paradise.\"\n  },\n  {\n   \"ar\": \"وَهُمْ جِيرَانِي\",\n   \"tr\": \"wa hum jirani\",\n   \"en\": \"They are my neighbors (therein).\"\n  },\n  {\n   \"ar\": \"وَلَوْلاَ انْتَ يَا عَلِيُّ\",\n   \"tr\": \"wa lawla anta ya `aliyyu\",\n   \"en\": \"Were it not for you `Ali,\"\n  },\n  {\n   \"ar\": \"لَمْ يُعْرَفِ ٱلْمُؤْمِنُونَ بَعْدِي.“\",\n   \"tr\": \"lam yu`raf almu'minuna ba`di\",\n   \"en\": \"true believers would not be recognized after me.”\"\n  },\n  {\n   \"ar\": \"وَكَانَ بَعْدَهُ هُدىٰ مِنَ ٱلضَّلاَلِ\",\n   \"tr\": \"wa kana ba`dahu hudan min alddalali\",\n   \"en\": \"Hence, he (i.e. `Ali), after the Prophet, was true guidance against straying off,\"\n  },\n  {\n   \"ar\": \"وَنُوراً مِنَ ٱلْعَمَىٰ\",\n   \"tr\": \"wa nuran min al`ama\",\n   \"en\": \"light against blindness,\"\n  },\n  {\n   \"ar\": \"وَحَبْلَ ٱللَّهِ ٱلْمَتِينَ\",\n   \"tr\": \"wa habla allahi almatina\",\n   \"en\": \"the firmest rope of Allah,\"\n  },\n  {\n   \"ar\": \"وَصِرَاطَهُ ٱلْمُسْتَقِيمَ\",\n   \"tr\": \"wa siratahu almustaqima\",\n   \"en\": \"and His straight path.\"\n  },\n  {\n   \"ar\": \"لاََ يُسْبَقُ بِقَرَابَةٍ فِي رَحِمٍ\",\n   \"tr\": \"la yusbaqu biqarabatin fi rahimin\",\n   \"en\": \"None would precede him in blood relation (with the Prophet)\"\n  },\n  {\n   \"ar\": \"وَلاَ بِسَابِقَةٍ فِي دِينٍ\",\n   \"tr\": \"wa la bisabiqatin fi dinin\",\n   \"en\": \"or any priority in a religious affair,\"\n  },\n  {\n   \"ar\": \"وَلاَ يُلْحَقُ فِي مَنْقَبَةٍ مِنْ مَنَاقِبِهِ\",\n   \"tr\": \"wa la yulhaqu fi manqabatin min manaqibihi\",\n   \"en\": \"and none would ever match him in any item of virtue.\"\n  },\n  {\n   \"ar\": \"يَحْذُو حَذْوَ ٱلرَّسُولِ\",\n   \"tr\": \"yahdhu hadhwa alrrasuli\",\n   \"en\": \"He patterned after the Messenger,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِمَا وَآلِهِمَا\",\n   \"tr\": \"salla allahu `alayhima wa alihima\",\n   \"en\": \"may Allah’s blessings be upon both of them and their Household.\"\n  },\n  {\n   \"ar\": \"وَيُقَاتِلُ عَلَىٰ ٱلتَّاوِيلِ\",\n   \"tr\": \"wa yuqatilu `ala altta'wili\",\n   \"en\": \"He fought for the sake of true interpretation (of the Qur'an).\"\n  },\n  {\n   \"ar\": \"وَلاَ تَاخُذُهُ فِي ٱللَّهِ لَوْمَةُ لاَئِمٍ\",\n   \"tr\": \"wa la ta'khudhuhu fi allahi lawmatu la'imin\",\n   \"en\": \"The blame of any blamer would never stop him from doing anything for the sake of Allah.\"\n  },\n  {\n   \"ar\": \"قَدْ وَتَرَ فِيهِ صَنَادِيدَ ٱلْعَرَبِ\",\n   \"tr\": \"qad watara fihi sanadida al`arabi\",\n   \"en\": \"He thus exterminated the villains of the Arabs,\"\n  },\n  {\n   \"ar\": \"وَقَتَلَ ابْطَالَهُمْ\",\n   \"tr\": \"wa qatala abtalahum\",\n   \"en\": \"killed their heroes,\"\n  },\n  {\n   \"ar\": \"وَنَاوَشَ ذُؤْبَانَهُمْ\",\n   \"tr\": \"wa nawasha dhu'banahum\",\n   \"en\": \"and eradicated their ferocious fighters.\"\n  },\n  {\n   \"ar\": \"فَاوْدَعَ قُلُوبَهُمْ احْقَاداً\",\n   \"tr\": \"fa'awda`a qulubahum ahqadan\",\n   \"en\": \"He therefore filled in their hearts with malice\"\n  },\n  {\n   \"ar\": \"بَدْرِيَّةً وَخَيْبَرِيَّةً وَحُنَيْنِيَّةً وَغَيْرَهُنَّ\",\n   \"tr\": \"badriyyatan wa khaybariyyatan wa hunayniyyatan wa ghayrahunna\",\n   \"en\": \"from the battles of Badr, Khaybar, and Hunayn as well as others.\"\n  },\n  {\n   \"ar\": \"فَاضَبَّتْ عَلَىٰ عَدَاوَتِهِ\",\n   \"tr\": \"fa'adabbat `ala `adawatihi\",\n   \"en\": \"Therefore, they clang inseparably to opposing him\"\n  },\n  {\n   \"ar\": \"وَاكَبَّتْ عَلَىٰ مُنَابَذَتِهِ\",\n   \"tr\": \"wa akabbat `ala munabadhatihi\",\n   \"en\": \"and attached upon dissenting him\"\n  },\n  {\n   \"ar\": \"حَتَّىٰ قَتَلَ ٱلنَّاكِثِينَ وَٱلْقَاسِطِينَ وَٱلْمَارِقِينَ\",\n   \"tr\": \"hatta qatala alnnakithina walqasitina walmariqina\",\n   \"en\": \"until he (had to) kill those who broke their oath/allegiance, and the unjust, and the apostates\\\"\"\n  },\n  {\n   \"ar\": \"وَلَمَّا قَضَىٰ نَحْبَهُ\",\n   \"tr\": \"wa lamma qada nahbahu\",\n   \"en\": \"When he passed away\"\n  },\n  {\n   \"ar\": \"وَقَتَلَهُ اشْقَىٰ ٱلآخِرِينَ يَتْبَعُ اشْقَىٰ ٱلاوَّلِينَ\",\n   \"tr\": \"wa qatalahu ashqa al-akhirina yatba`u ashqa al-awwalina\",\n   \"en\": \"and he was killed by the most miserable of all of the late generations who will be attached to the most miserable of the past generations,\"\n  },\n  {\n   \"ar\": \"لَمْ يُمْتَثَلْ امْرُ رَسُولِ ٱللَّهِ\",\n   \"tr\": \"lam yumtathal amru rasuli allahi\",\n   \"en\": \"the decree of Allah’s Messenger,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"may Allah bless him and his Household,\"\n  },\n  {\n   \"ar\": \"فِي ٱلْهَادِينَ بَعْدَ ٱلْهَادِينَ\",\n   \"tr\": \"fi alhadina ba`da alhadina\",\n   \"en\": \"about the leadership of the successive guiding ones was not carried out;\"\n  },\n  {\n   \"ar\": \"وَٱلامَّةُ مُصِرَّةٌ عَلَىٰ مَقْتِهِ\",\n   \"tr\": \"wal-ummatu musirratun `ala maqtihi\",\n   \"en\": \"rather, the people insisted on detesting him\"\n  },\n  {\n   \"ar\": \"مُجْتَمِعَةٌ عَلَىٰ قَطِيعَةِ رَحِمِهِ\",\n   \"tr\": \"mujtami`atun `ala qati`ati rahimihi\",\n   \"en\": \"and agreed unanimously on rupturing their relations with him\"\n  },\n  {\n   \"ar\": \"وَإِِقْصَاءِ وُلْدِهِ\",\n   \"tr\": \"wa iqsa'i wuldihi\",\n   \"en\": \"and moving away his descendants (from leadership),\"\n  },\n  {\n   \"ar\": \"إِِلاَّ ٱلْقَلِيلَ مِمَّنْ وَفَىٰ لِرِعَايَةِ ٱلْحَقِّ فِيهِمْ\",\n   \"tr\": \"illa alqalila mimman wafa liri`ayati alhaqqi fihim\",\n   \"en\": \"except for a few ones who fulfilled the duty of observing their rights.\"\n  },\n  {\n   \"ar\": \"فَقُتِلَ مَنْ قُتِلَ\",\n   \"tr\": \"faqutila man qutila\",\n   \"en\": \"Many (of `Ali’s descendants) were therefore slain,\"\n  },\n  {\n   \"ar\": \"وَسُبِيَ مَنْ سُبِيَ\",\n   \"tr\": \"wa subiya man subiya\",\n   \"en\": \"many others were taken as captives,\"\n  },\n  {\n   \"ar\": \"وَاقْصِيَ مَنْ اقْصِيَ\",\n   \"tr\": \"wa uqsiya man uqsiya\",\n   \"en\": \"and many others were banished.\"\n  },\n  {\n   \"ar\": \"وَجَرَىٰ ٱلْقَضَاءُ لَهُمْ\",\n   \"tr\": \"wa jara alqada'u lahum\",\n   \"en\": \"Decrees were thus applied to them\"\n  },\n  {\n   \"ar\": \"بِمَا يُرْجَىٰ لَهُ حُسْنُ ٱلْمَثُوبَةِ\",\n   \"tr\": \"bima yurja lahu husnu almathubati\",\n   \"en\": \"in a form expected to grant them excellent reward for that.\"\n  },\n  {\n   \"ar\": \"إِِذْ كَانَتِ ٱلارْضُ لِلَّهِ\",\n   \"tr\": \"idh kanat al-ardu lillahi\",\n   \"en\": \"Verily, the earth is Allah’s;\"\n  },\n  {\n   \"ar\": \"يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ\",\n   \"tr\": \"yurithuha man yasha'u min `ibadihi\",\n   \"en\": \"He gives it in inheritance to whomever of His servants that He wishes;\"\n  },\n  {\n   \"ar\": \"وَٱلْعَاقِبَةُ لِلْمُتَّقِينَ\",\n   \"tr\": \"wal`aqibatu lilmuttaqina\",\n   \"en\": \"and the end result shall be for the pious.\"\n  },\n  {\n   \"ar\": \"وَسُبْحَانَ رَبِّنَا\",\n   \"tr\": \"wa subhana rabbina\",\n   \"en\": \"All glory be to our Lord.\"\n  },\n  {\n   \"ar\": \"إِِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُولاًَ\",\n   \"tr\": \"in kana wa`du rabbina lamaf`ulan\",\n   \"en\": \"Most certainly, the promise of our Lord shall come to pass.\"\n  },\n  {\n   \"ar\": \"وَلَنْ يُخْلِفَ ٱللَّهُ وَعْدَهُ\",\n   \"tr\": \"wa lan yukhlifa allahu wa`dahu\",\n   \"en\": \"Allah shall never fail to fulfill His promise.\"\n  },\n  {\n   \"ar\": \"وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ\",\n   \"tr\": \"wa huwa al`azizu alhakimu\",\n   \"en\": \"He is the Almighty, the All-wise.\"\n  },\n  {\n   \"ar\": \"فَعَلَىٰ ٱلاطَائِبِ مِنْ اهْلِ بَيْتِ مُحَمَّد وَعَلِيٍّ\",\n   \"tr\": \"fa`ala al-ata'ibi min ahli bayti muhammadin wa `aliyyin\",\n   \"en\": \"For the immaculate ones from the household of Muhammad and `Ali,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِمَا وَآلِهِمَا\",\n   \"tr\": \"salla allahu `alayhima wa alihima\",\n   \"en\": \"may Allah bless both of them and their household,\"\n  },\n  {\n   \"ar\": \"فَلْيَبْكِ ٱلْبَاكُونَ\",\n   \"tr\": \"falyabki albakuna\",\n   \"en\": \"let weepers weep.\"\n  },\n  {\n   \"ar\": \"وَإِِيَّاهُمْ فَلْيَنْدُبِ ٱلنَّادِبُونَ\",\n   \"tr\": \"wa iyyahum falyandub alnnadibuna\",\n   \"en\": \"For them too, let lamenters lament.\"\n  },\n  {\n   \"ar\": \"وَلِمِثْلِهِمْ فَلْتَذْرِفِ ٱلدُّمُوعُ\",\n   \"tr\": \"wa limithlihim faltadhrif alddumu`u\",\n   \"en\": \"For the like of them, let tears be shed,\"\n  },\n  {\n   \"ar\": \"وَلْيَصْرُخِ ٱلصَّارِخُونَ\",\n   \"tr\": \"walyasrukh alssarikhuna\",\n   \"en\": \"screamers scream,\"\n  },\n  {\n   \"ar\": \"وَيَضِجَّ ٱلضَّاجُّونَ\",\n   \"tr\": \"wa yadijja alddajjuna\",\n   \"en\": \"yellers yell,\"\n  },\n  {\n   \"ar\": \"وَيَعِجَّ ٱلْعَاجُّوَنَ\",\n   \"tr\": \"wa ya`ijja al`ajjuna\",\n   \"en\": \"and wailers wail.\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْحَسَنُ ايْنَ ٱلْحُسَيْنُ\",\n   \"tr\": \"ayna alhasanu ayna alhusaynu\",\n   \"en\": \"Where is al-Hasan? Where is al-Husayn?\"\n  },\n  {\n   \"ar\": \"ايْنَ ابْنَاءُ ٱلْحُسَيْنِ\",\n   \"tr\": \"ayna abna'u alhusayni\",\n   \"en\": \"Where are the sons of al-Husayn;\"\n  },\n  {\n   \"ar\": \"صَالِحٌ بَعْدَ صَالِحٍ\",\n   \"tr\": \"salihun ba`da salihin\",\n   \"en\": \"a virtuous one after another,\"\n  },\n  {\n   \"ar\": \"وَصَادِقٌ بَعْدَ صَادِقٍ\",\n   \"tr\": \"wa sadiqun ba`da sadiqin\",\n   \"en\": \"and a veracious one after another?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلسَّبِيلُ بَعْدَ ٱلسَّبِيلِ\",\n   \"tr\": \"ayna alssabilu ba`da alssabili\",\n   \"en\": \"Where is the course (to Allah) after a course?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْخِيَرَةُ بَعْدَ ٱلْخِيَرَةِ\",\n   \"tr\": \"ayna alkhiyaratu ba`da alkhiyarati\",\n   \"en\": \"Where is the best after the best?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلشُّمُوسُ ٱلطَّالِعَةُ\",\n   \"tr\": \"ayna alshshumusu alttali`atu\",\n   \"en\": \"Where are the rising suns?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلاقْمَارُ ٱلْمُنِيرَةُ\",\n   \"tr\": \"ayna al-aqmaru almuniratu\",\n   \"en\": \"Where are the shining moons?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلانْجُمُ ٱلزَّاهِرَةُ\",\n   \"tr\": \"ayna al-anjumu alzzahiratu\",\n   \"en\": \"Where are the brilliant stars?\"\n  },\n  {\n   \"ar\": \"ايْنَ اعْلاَمُ ٱلدِّينِ\",\n   \"tr\": \"ayna a`lamu alddini\",\n   \"en\": \"Where are the authorities of the religion\"\n  },\n  {\n   \"ar\": \"وَقَوَاعِدُ ٱلْعِلْمِ\",\n   \"tr\": \"wa qawa`idu al`ilmi\",\n   \"en\": \"and the foundations of knowledge?\"\n  },\n  {\n   \"ar\": \"ايْنَ بَقِيَّةُ ٱللَّهِ\",\n   \"tr\": \"ayna baqiyyatu allahi\",\n   \"en\": \"Where is the left by Allah\"\n  },\n  {\n   \"ar\": \"ٱلَّتِي لاََ تَخْلُو مِنَ ٱلْعِتْرَةِ ٱلْهَادِيةِ\",\n   \"tr\": \"allati la takhlu min al`itrati alhadiyati\",\n   \"en\": \"that is always represented by individuals from the guiding (Prophetic) offspring?\"\n  },\n  {\n   \"ar\": \"اينَ ٱلْمُعَدُّ لِقَطْعِ دَابِرِ ٱلظَّلَمَةِ\",\n   \"tr\": \"ayna almu`addu liqat`i dabiri alzzalamati\",\n   \"en\": \"Where is the one prepared for cutting off the roots of the wrongdoers?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُنْتَظَرُ لإِِِقَامَةِ ٱلامْتِ وَٱلعِوَجِ\",\n   \"tr\": \"ayna almuntazaru li'iqamati al-amti wal`iwaji\",\n   \"en\": \"Where is the one awaited for mending every unevenness and crookedness?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُرْتَجىٰ لإِِزَالَةِ ٱلْجَوْرِ وَٱلْعُدْوَانِ\",\n   \"tr\": \"ayna almurtaja li'izalati aljawri wal`udwani\",\n   \"en\": \"Where is the one hoped for removing oppression and aggression?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُدَّخَرُ لِتَجْدِيدِ ٱلْفَرَائِضِ وَٱلسُّنَنِ\",\n   \"tr\": \"ayna almuddakharu litajdidi alfara'idi walssunani\",\n   \"en\": \"Where is the one spared for refreshing the duties and traditions?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُتَخَيَّرُ لإِِِعَادَةِ ٱلْمِلَّةِ وَٱلشَّرِيعَةِ\",\n   \"tr\": \"ayna almutakhayyaru li'i`adati almillati walshshari`ati\",\n   \"en\": \"Where is the one chosen for restoring the faith and the code of law?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُؤَمَّلُ لإِِِحْيَاءِ ٱلْكِتَابِ وَحُدُودِهِ\",\n   \"tr\": \"ayna almu'ammalu li'ihya'i alkitabi wa hududihi\",\n   \"en\": \"Where is the one expected to restore to life the Book and its provisions?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُحْيِي مَعَالِمِ ٱلدِّينِ وَاهْلِهِ\",\n   \"tr\": \"ayna muhyi ma`alimi alddini wa ahlihi\",\n   \"en\": \"Where is the reviver of the elements of the religion and its people?\"\n  },\n  {\n   \"ar\": \"ايْنَ قَاصِمُ شَوْكَةِ ٱلْمُعْتَدِينَ\",\n   \"tr\": \"ayna qasimu shawkati almu`tadina\",\n   \"en\": \"Where is the one shattering the arms of the aggressors?\"\n  },\n  {\n   \"ar\": \"ايْنَ هَادِمُ ابْنِيَةِ ٱلشِّرْكِ وَٱلنِّفَاقِ\",\n   \"tr\": \"ayna hadimu abniyati alshshirki walnnifaqi\",\n   \"en\": \"Where is the one demolishing the edifices of polytheism and hypocrisy?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُبِيدُ اهْلِ ٱلْفُسُوقِ\",\n   \"tr\": \"ayna mubidu ahli alfusuqi\",\n   \"en\": \"Where is the one annihilating the people of wickedness,\"\n  },\n  {\n   \"ar\": \"وَٱلْعِصْيَانِ وَٱلطُّغْيَانِ\",\n   \"tr\": \"wal`isyani walttughyani\",\n   \"en\": \"disobedience, and tyranny?\"\n  },\n  {\n   \"ar\": \"ايْنَ حَاصِدُ فُرُوعِ ٱلْغَيِّ وَٱلشِّقَاقِ\",\n   \"tr\": \"ayna hasidu furu`i alghayyi walshshiqaqi\",\n   \"en\": \"Where is the one uprooting the branches of error and insurgence?\"\n  },\n  {\n   \"ar\": \"ايْنَ طَامِسُ آثَارِ ٱلزَّيْغِ وَٱلاهْوَاءِ\",\n   \"tr\": \"ayna tamisu athari alzzayghi wal-ahwa'i\",\n   \"en\": \"Where is the one effacing the traces of evasiveness and personal desires?\"\n  },\n  {\n   \"ar\": \"ايْنَ قَاطِعُ حَبَائِلِ ٱلْكِذْبِ وَٱلٱِفْتِرَاءِ\",\n   \"tr\": \"ayna qati`u haba'ili alkidhbi waliftira'i\",\n   \"en\": \"Where is the one severing the ropes of fabrication and forgery?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُبِيدُ ٱلْعُتَاةِ وَٱلْمَرَدَةِ\",\n   \"tr\": \"ayna mubidu al`utati walmaradati\",\n   \"en\": \"Where is the one terminating the insolent defiant and persistent rebels?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُسْتَاصِلُ اهْلِ ٱلْعِنَادِ وَٱلتَّضْلِيلِ وَٱلإِلْحَادِ\",\n   \"tr\": \"ayna musta'silu ahli al`inadi walttadlili wal-ilhadi\",\n   \"en\": \"Where is the one tearing up the people of obstinacy, misleading, and atheism?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُعِزُّ ٱلاوْلِيَاءِ وَمُذِلُّ ٱلاعْدَاءِ\",\n   \"tr\": \"ayna mu`izzu al-awliya'i wa mudhillu al-a`da'i\",\n   \"en\": \"Where is the one ennobling the saints and humiliating the enemies?\"\n  },\n  {\n   \"ar\": \"ايْنَ جَامِعُ ٱلْكَلِمَةِ عَلَىٰ ٱلتَّقْوَىٰ\",\n   \"tr\": \"ayna jami`u alkalimati `ala alttaqwa\",\n   \"en\": \"Where is the one bringing together (all scattered) words to piety?\"\n  },\n  {\n   \"ar\": \"ايْنَ بَابُ ٱللَّهِ ٱلَّذِي مِنْهُ يُؤْتَىٰ\",\n   \"tr\": \"ayna babu allahi alladhi minhu yu'ta\",\n   \"en\": \"Where is the door of Allah from which Allah is come?\"\n  },\n  {\n   \"ar\": \"ايْنَ وَجْهُ ٱللَّهِ ٱلَّذِي إِِلَيْهِ يَتَوَجَّهُ ٱلاوْلِيَاءُ\",\n   \"tr\": \"ayna wajhu allahi alladhi ilayhi yatawajjahu al-awliya'u\",\n   \"en\": \"Where is the Face of Allah towards whom the saints turn their faces.\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلسَّبَبُ ٱلْمُتَّصِلُ بَيْنَ ٱلارْضِ وَٱلسَّمَاءِ\",\n   \"tr\": \"ayna alssababu almuttasilu bayna al-ardi walssama'i\",\n   \"en\": \"Where is the means of access that is connectedly extended between the earth and the heavens.\"\n  },\n  {\n   \"ar\": \"ايْنَ صَاحِبُ يَوْمِ ٱلْفَتْحِ\",\n   \"tr\": \"ayna sahibu yawmi alfathi\",\n   \"en\": \"Where is the patron of the Conquest Day\"\n  },\n  {\n   \"ar\": \"وَنَاشِرُ رَايَةِ ٱلْهُدَىٰ\",\n   \"tr\": \"wa nashiru rayati alhuda\",\n   \"en\": \"and the stretcher of the pennon of true guidance?\"\n  },\n  {\n   \"ar\": \"ايْنَ مُؤَلِّفُ شَمْلِ ٱلصَّلاَحِ وَٱلرِّضَا\",\n   \"tr\": \"ayna mu'allifu shamli alssalahi walrrida\",\n   \"en\": \"Where is the one reunifying the dispersed parts of uprightness and contentment?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلطَّالِبُ بِذُحُولِ ٱلانْبِيَاءِ وَابْنَاءِ ٱلانْبِيَاءِ\",\n   \"tr\": \"ayna alttalibu bidhuhuli al-anbiya'i wa abna'i al-anbiya'i\",\n   \"en\": \"Where is the one demanding with the vengeance of the Prophets and their sons?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلطَّالِبُ بِدَمِ ٱلْمَقْتُولِ بِكَرْبَلاَءَ\",\n   \"tr\": \"ayna alttalibu bidami almaqtuli bikarbala'a\",\n   \"en\": \"Where is the one demanding with the blood of the one slain in Karbala'?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمَنْصُورُ عَلَىٰ مَنِ ٱعْتَدَىٰ عَلَيْهِ وَٱفْتَرَىٰ\",\n   \"tr\": \"ayna almansuru `ala man i`tada `alayhi waftara\",\n   \"en\": \"Where is the one granted aid against whomever transgresses and forges lies against him?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱلْمُضْطَرُّ ٱلَّذِي يُجَابُ إِِذَا دَعَا\",\n   \"tr\": \"ayna almudtarru alladhi yujabu idha da`a\",\n   \"en\": \"Where is the distressed who is answered when he prays?\"\n  },\n  {\n   \"ar\": \"ايْنَ صَدْرُ ٱلْخَلاَئِقِ ذُوُ ٱلْبِرِّ وَٱلتَّقْوَىٰ\",\n   \"tr\": \"ayna sadru alkhala'iqi dhu albirri walttaqwa\",\n   \"en\": \"Where is the forepart of the creatures who enjoys dutifulness and piety?\"\n  },\n  {\n   \"ar\": \"ايْنَ ٱبْنُ ٱلنَّبِيِّ ٱلْمُصْطَفَىٰ\",\n   \"tr\": \"ayna ibnu alnnabiyyi almustafa\",\n   \"en\": \"Where is the son of the well-chosen Prophet,\"\n  },\n  {\n   \"ar\": \"وَٱبْنُ عَلِيٍّ ٱلْمُرْتَضَىٰ\",\n   \"tr\": \"wabnu `aliyyin almurtada\",\n   \"en\": \"the son of `Ali the well-pleased,\"\n  },\n  {\n   \"ar\": \"وَٱبْنُ خَدِيـجَةَ ٱلْغَرَّاءِ\",\n   \"tr\": \"wabnu khadijata algharra'i\",\n   \"en\": \"the son of Khadijah the glittery lady,\"\n  },\n  {\n   \"ar\": \"وَٱبْنُ فَاطِمَةَ ٱلْكُبْرَىٰ\",\n   \"tr\": \"wabnu fatimata alkubra\",\n   \"en\": \"and the son of Fatimah the grand lady?\"\n  },\n  {\n   \"ar\": \"بِابِي انْتَ وَامِّي\",\n   \"tr\": \"bi'abi anta wa ummi\",\n   \"en\": \"May my father and mother be ransoms for you.\"\n  },\n  {\n   \"ar\": \"وَنَفْسِي لَكَ ٱلْوِقَاءُ وَٱلْحِمَىٰ\",\n   \"tr\": \"wa nafsi laka alwiqa'u walhima\",\n   \"en\": \"May my soul be protection and shield for you.\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلسَّادَةِ ٱلْمُقَرَّبِينَ\",\n   \"tr\": \"yabna alssadati almuqarrabina\",\n   \"en\": \"O son of the chiefs drawn near!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلنُّجَبَاءِ ٱلاكْرَمِينَ\",\n   \"tr\": \"yabna alnnujaba'i al-akramina\",\n   \"en\": \"O son of the most honorable, outstanding ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْهُدَاةِ ٱلْمَهْدِيِّينَ\",\n   \"tr\": \"yabna alhudati almahdiyyina\",\n   \"en\": \"O son of the guiding and well-guided ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْخِيَرَةِ ٱلْمُهَذَّبِينَ\",\n   \"tr\": \"yabna alkhiyarati almuhadhdhabina\",\n   \"en\": \"O son of the ever-best refined ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْغَطَارِفَةِ ٱلانْجَبِينَ\",\n   \"tr\": \"yabna alghatarifati al-anjabina\",\n   \"en\": \"O son of the all-liberal and all-select ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلاطَائِبِ ٱلْمُطَهَّرِينَ\",\n   \"tr\": \"yabna al-ata'ibi almutahharina\",\n   \"en\": \"O son of the immaculate and purified ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْخَضَارِمَةِ ٱلْمُنْتَجَبِينَ\",\n   \"tr\": \"yabna alkhadarimati almuntajabina\",\n   \"en\": \"O son of the ample-giving, finely elected ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْقَمَاقِمَةِ ٱلاكْرَمِينَ\",\n   \"tr\": \"yabna alqamaqimati al-akramina\",\n   \"en\": \"O son of the bounteous, most honorable ones!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْبُدُورِ ٱلْمُنِيرَةِ\",\n   \"tr\": \"yabna albuduri almunirati\",\n   \"en\": \"O son of light-giving full moons!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلسُّرُجِ ٱلْمُضِيئَةِ\",\n   \"tr\": \"yabna alssuruji almudi'ati\",\n   \"en\": \"O son of beaming lanterns!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلشُّهُبِ ٱلثَّاقِبَةِ\",\n   \"tr\": \"yabna alshshuhubi alththaqibati\",\n   \"en\": \"O son of piercing flames!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلانْجُمِ ٱلزَّاهِرَةِ\",\n   \"tr\": \"yabna al-anjumi alzzahirati\",\n   \"en\": \"O son of luminous stars!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلسُّبُلِ ٱلْوَاضِحَةِ\",\n   \"tr\": \"yabna alssubuli alwadihati\",\n   \"en\": \"O son of patent ways!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلاعْلاَمِ ٱللاَّئِحَةِ\",\n   \"tr\": \"yabna al-a`lami alla'ihati\",\n   \"en\": \"O son of obvious signs!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْعُلُومِ ٱلْكَامِلَةِ\",\n   \"tr\": \"yabna al`ulumi alkamilati\",\n   \"en\": \"O son of perfect knowledge!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلسُّنَنِ ٱلْمَشْهُورَةِ\",\n   \"tr\": \"yabna alssunani almashhurati\",\n   \"en\": \"O son of renowned traditions!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْمَعَالِمِ ٱلْمَاثُورَةِ\",\n   \"tr\": \"yabna alma`alimi alma'thurati\",\n   \"en\": \"O son of well-established features!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْمُعْجِزَاتِ ٱلْمَوْجُودَةِ\",\n   \"tr\": \"yabna almu`jizati almawjudati\",\n   \"en\": \"O son of well-known miracles!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلدَّلاَئِلِ ٱلْمَشْهُودَةِ\",\n   \"tr\": \"yabna alddala'ili almashhudati\",\n   \"en\": \"O son of widely witnessed demonstrations!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلصِّرَاطِ ٱلْمُسْتَقِيمِ\",\n   \"tr\": \"yabna alssirati almustaqimi\",\n   \"en\": \"O son of the straight path!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلنَّبَإِ ٱلْعَظِيمِ\",\n   \"tr\": \"yabna alnnaba'i al`azimi\",\n   \"en\": \"O son of the great news!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ مَنْ هُوَ فِي امِّ ٱلْكِتَابِ لَدَىٰ ٱللَّهِ عَلِيٌّ حَكِيمٌ\",\n   \"tr\": \"yabna man huwa fi ummi alkitabi lada allahi `aliyyun hakimun\",\n   \"en\": \"O son of him who is elevated and full of wisdom in the original of the Book with Allah.\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلآيَاتِ وَٱلْبَيِّنَاتِ\",\n   \"tr\": \"yabna al-ayati walbayyinati\",\n   \"en\": \"O son of signs and manifestations!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلدَّلاَئِلِ ٱلظَّاهِرَاتِ\",\n   \"tr\": \"yabna alddala'ili alzzahirati\",\n   \"en\": \"O son of apparent points of evidence!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْبَرَاهِينِ ٱلْوَاضِحَاتِ ٱلْبَاهِرَاتِ\",\n   \"tr\": \"yabna albarahini alwadihati albahirati\",\n   \"en\": \"O son of clear-cut and dazzling substantiations!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلْحُجَجِ ٱلْبَالِغَاتِ\",\n   \"tr\": \"yabna alhujaji albalighati\",\n   \"en\": \"O son of conclusive arguments!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلنِّعَمِ ٱلسَّابِغَاتِ\",\n   \"tr\": \"yabna alnni`ami alssabighati\",\n   \"en\": \"O son of superabundant bounties!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ طـٰهٰ وَٱلْمُحْكَمَاتِ\",\n   \"tr\": \"yabna taha walmuhkamati\",\n   \"en\": \"O son of Taha and the decisive (verses)!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ يـٰس وَٱلذَّارِيَاتِ\",\n   \"tr\": \"yabna yasin waldhdhariyati\",\n   \"en\": \"O son of Yasin and al-Dhariyat (the winnowing winds)!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ ٱلطُّورِ وَٱلْعَادِيَاتِ\",\n   \"tr\": \"yabna altturi wal`adiyati\",\n   \"en\": \"O son of al-Tur (the Mount of Revelation) and al-`ªdiyat (the running steeds)!\"\n  },\n  {\n   \"ar\": \"يَا بْنَ مَنْ دَنَا فَتَدَلَّىٰ\",\n   \"tr\": \"yabna man dana fatadalla\",\n   \"en\": \"O son of him who drew near and then bowed;\"\n  },\n  {\n   \"ar\": \"فَكَانَ قَابَ قَوْسَيْنِ اوْ ادْنَىٰ\",\n   \"tr\": \"fakana qaba qawsayni aw adna\",\n   \"en\": \"he therefore was the measure of two bows or closer still;\"\n  },\n  {\n   \"ar\": \"دُنُوّاً وَٱقْتِرَاباً مِنَ ٱلْعَلِيِّ ٱلاعْلَىٰ\",\n   \"tr\": \"dunuwwan waqtiraban min al`aliyyi al-a`la\",\n   \"en\": \"nearness and closeness to the Most High and Most Exalted (Lord)!\"\n  },\n  {\n   \"ar\": \"لَيْتَ شِعْرِي ايْنَ ٱسْتَقَرَّتْ بِكَ ٱلنَّوَىٰ\",\n   \"tr\": \"layta shi`ri ayna istaqarrat bika alnnawa\",\n   \"en\": \"How I wonder! Where has farness taken you?\"\n  },\n  {\n   \"ar\": \"بَلْ ايُّ ارْضٍ تُقِلُّكَ اوْ ثَرَىٰ\",\n   \"tr\": \"bal ayya ardin tuqilluka aw thara\",\n   \"en\": \"Or which land or soil is carrying you?\"\n  },\n  {\n   \"ar\": \"ابِرَضْوَىٰ اوْ غَيْرِهَا امْ ذِي طُوَىٰٰ\",\n   \"tr\": \"abiradwa aw ghayriha am dhi tuwa\",\n   \"en\": \"Is it on (Mount) Radwa or elsewhere on (Mount) Dhi-Tuwa?\"\n  },\n  {\n   \"ar\": \"عَزِيزٌ عَلَيَّ انْ ارَىٰ ٱلْخَلْقَ وَلاَ تُرَىٰ\",\n   \"tr\": \"`azizun `alayya an ara alkhalqa wa la tura\",\n   \"en\": \"It is hard for me that I can see all creatures but I can neither see you\"\n  },\n  {\n   \"ar\": \"وَلاَ اسْمَعُ لَكَ حَسِيساً وَلاَ نَجْوَىٰ\",\n   \"tr\": \"wa la asma`u laka hasisan wa la najwa\",\n   \"en\": \"nor can I hear any whisper or confidential talk from you!\"\n  },\n  {\n   \"ar\": \"عَزِيزٌ عَلَيَّ انْ تُحِيطَ بِكَ دُونِيَ ٱلْبَلْوَىٰ\",\n   \"tr\": \"`azizun `alayya an tuhita bika duniya albalwa\",\n   \"en\": \"It is hard for me that ordeals encompass you, not me\"\n  },\n  {\n   \"ar\": \"وَلاَ يَنَالُكَ مِنِّي ضَجِيجٌ وَلاَ شَكْوَىٰ\",\n   \"tr\": \"wa la yanaluka minni dajijun wa la shakwa\",\n   \"en\": \"and neither cry nor complaint from me can rally round you!\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ مُغَيَّبٍ لَمْ يَخْلُ مِنَّا\",\n   \"tr\": \"binafsi anta min mughayyabin lam yakhlu minna\",\n   \"en\": \"May my soul be ransom for you; for although you are hidden from us, you have never forsaken us.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ نَازِحٍ مَا نَزَحَ عَنَّا\",\n   \"tr\": \"binafsi anta min nazihin ma nazaha `anna\",\n   \"en\": \"May my soul be ransom for you; for although you are away, you have never been away from us.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ امْنِيَّةُ شَائِقٍ يَتَمَنَّىٰ\",\n   \"tr\": \"binafsi anta umniyyatu sha'iqin yatamanna\",\n   \"en\": \"May my soul be ransom for you; for you are the wish of an eager\"\n  },\n  {\n   \"ar\": \"مِنْ مُؤْمِنٍ وَمُؤْمِنَةٍ ذَكَرَا فَحَنَّا\",\n   \"tr\": \"min mu'minin wa mu'minatin dhakara fahanna\",\n   \"en\": \"believing man or woman who mention you and miss you.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ عَقِيدِ عِزٍّ لاَ يُسَامَىٰ\",\n   \"tr\": \"binafsi anta min `aqidi `izzin la yusama\",\n   \"en\": \"May my soul be ransom for you; for you are an unmatched pioneer of dignity.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ اثِيلِ مَجْدٍ لاَ يُجَارَىٰ\",\n   \"tr\": \"binafsi anta min athili majdin la yujara\",\n   \"en\": \"May my soul be ransom for you; for you are an unrivaled origin of glory.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ تِلاَدِ نِعَمٍ لاََ تُضَاهَىٰ\",\n   \"tr\": \"binafsi anta min tiladi ni`amin la tudaha\",\n   \"en\": \"May my soul be ransom for you; for you are unparalleled center of bounties.\"\n  },\n  {\n   \"ar\": \"بِنَفْسِي انْتَ مِنْ نَصِيفِ شَرَفٍ لاََ يُسَاوَىٰ\",\n   \"tr\": \"binafsi anta min nasifi sharafin la yusawa\",\n   \"en\": \"May my soul be ransom for you; for you are unequaled in all-inclusive honor.\"\n  },\n  {\n   \"ar\": \"إِلَىٰ مَتَىٰ احَارُ فِيكَ يَا مَوْلاَيَ وَإِِلَىٰ مَتَىٰ\",\n   \"tr\": \"ila mata aharu fika ya mawlaya wa ila mata\",\n   \"en\": \"Until when will I be bewildered about you, O my master, and until when?\"\n  },\n  {\n   \"ar\": \"وَايَّ خِطَابٍ اصِفُ فِيكَ وَايَّ نَجْوَىٰ\",\n   \"tr\": \"wa ayya khitabin asifu fika wa ayya najwa\",\n   \"en\": \"In what kind of statement and in what kind of talk can I describe you?\"\n  },\n  {\n   \"ar\": \"عَزِيزٌ عَلَيَّ انْ اجَابَ دُونَكَ وَانَاغَىٰ\",\n   \"tr\": \"`azizun `alayya an ujaba dunaka wa unagha\",\n   \"en\": \"It is hard for me that I can receive answers and words, but you cannot.\"\n  },\n  {\n   \"ar\": \"عَزِيزٌ عَلَيَّ انْ ابْكِيَكَ وَيَخْذُلَكَ ٱلْوَرَىٰ\",\n   \"tr\": \"`azizun `alayya an abkiyaka wa yakhdhulaka alwara\",\n   \"en\": \"It is hard for me that I weep for you but the others disappoint you.\"\n  },\n  {\n   \"ar\": \"عَزِيزٌ عَلَيَّ انْ يَجْرِيَ عَلَيْكَ دُونَهُمْ مَا جَرَىٰ\",\n   \"tr\": \"`azizun `alayya an yajriya `alayka dunahum ma jara\",\n   \"en\": \"It is hard for me that what has happened afflict you other than all the others.\"\n  },\n  {\n   \"ar\": \"هَلْ مِنْ مُعِينٍ فَاطِيلَ مَعَهُ ٱلْعَوِيلَ وَٱلْبُكَاءَ\",\n   \"tr\": \"hal min mu`inin fa'utila ma`ahu al`awila walbuka'a\",\n   \"en\": \"Is there any helper with whom I may lament and bewail as much as I wish?\"\n  },\n  {\n   \"ar\": \"هَلْ مِنْ جَزُوعٍ فَاسَاعِدَ جَزَعَهُ إِِذَا خَلاَ\",\n   \"tr\": \"hal min jazu`in fa'usa`ida jaza`ahu idha khala\",\n   \"en\": \"Is there any aggrieved one whom I can help in grief when he becomes tired?\"\n  },\n  {\n   \"ar\": \"هَلْ قَذِيَتْ عَيْنٌ فَسَاعَدَتْهَا عَيْنِي عَلَىٰ ٱلْقَذَىٰ\",\n   \"tr\": \"hal qadhiyat `aynun fasa`adat-ha `ayni `ala alqadha\",\n   \"en\": \"Is there any eye moling out and thus my eye may help it to mol out more?\"\n  },\n  {\n   \"ar\": \"هَلْ إِِلَيْكَ يَا بْنَ احْمَدَ سَبِيلٌ فَتُلْقَىٰ\",\n   \"tr\": \"hal ilayka yabna ahmada sabilun fatulqa\",\n   \"en\": \"Is there any way to meet you, O son of Ahmad (the Prophet)?\"\n  },\n  {\n   \"ar\": \"هَلْ يَتَّصِلُ يَوْمُنَا مِنْكَ بِعِدَةٍ فَنَحْظَىٰ\",\n   \"tr\": \"hal yattasilu yawmuna minka bi`idatin fanahza\",\n   \"en\": \"Will our day be promised to catch your day and we will thus achieve our hope?\"\n  },\n  {\n   \"ar\": \"مَتَىٰ نَرِدُ مَنَاهِلَكَ ٱلرَّوِيَّةَ فَنَرْوَىٰ\",\n   \"tr\": \"mata naridu manahilaka alrrawiyyata fanarwa\",\n   \"en\": \"When will we be able to join your refreshing springs and we will then be satiated?\"\n  },\n  {\n   \"ar\": \"مَتَىٰ نَنْتَقِعُ مِنْ عَذْبِ مَائِكَ\",\n   \"tr\": \"mata nantaqi`u min `adhbi ma'ika\",\n   \"en\": \"When will we quench our thirst from your fresh water,\"\n  },\n  {\n   \"ar\": \"فَقَدْ طَالَ ٱلصَّدَىٰ\",\n   \"tr\": \"faqad tala alssada\",\n   \"en\": \"because thirst has been too long?\"\n  },\n  {\n   \"ar\": \"مَتَىٰ نُغَادِيكَ وَنُرَاوِحُكَ فَنُقِرَّ عَيْناً\",\n   \"tr\": \"mata nughadika wa nurawihuka fanuqirra `aynan\",\n   \"en\": \"When will we accompany you in coming and going so that our eyes will be delighted?\"\n  },\n  {\n   \"ar\": \"مَتَىٰ تَرَانَا وَنَرَاكَ وَقَدْ نَشَرْتَ لِوَاءَ ٱلنَّصْرِ تُرَىٰ\",\n   \"tr\": \"mata tarana wa naraka wa qad nasharta liwa'a alnnasri tura\",\n   \"en\": \"When will you see us and we see you spreading the pennon of victory?\"\n  },\n  {\n   \"ar\": \"اتَرَانَا نَحُفُّ بِكَ وَانْتَ تَؤُمُّ ٱلْمَلَا\",\n   \"tr\": \"atarana nahuffu bika wa anta ta'ummu almala'a\",\n   \"en\": \"Can it be that we surround you while you are leading the groups,\"\n  },\n  {\n   \"ar\": \"وَقَدْ مَلَاتَ ٱلارْضَ عَدْلاًَ\",\n   \"tr\": \"wa qad mala'ta al-arda `adlan\",\n   \"en\": \"after you will have filled in the earth with justice,\"\n  },\n  {\n   \"ar\": \"وَاذَقْتَ اعْدَاءَكَ هَوَاناً وَعِقَاباً\",\n   \"tr\": \"wa adhaqta a`da'aka hawanan wa `iqaban\",\n   \"en\": \"tasted your enemies humiliation and punishment,\"\n  },\n  {\n   \"ar\": \"وَابَرْتَ ٱلْعُتَاةَ وَجَحَدَةَ ٱلْحَقِّ\",\n   \"tr\": \"wa abarta al`utata wa jahadata alhaqqi\",\n   \"en\": \"annihilated the insolent defiant and the deniers of the truth,\"\n  },\n  {\n   \"ar\": \"وَقَطَعْتَ دَابِرَ ٱلْمُتَكَبِّرِينَ\",\n   \"tr\": \"wa qata`ta dabira almutakabbirina\",\n   \"en\": \"cut off the roots of the arrogant,\"\n  },\n  {\n   \"ar\": \"وَٱجْتَثَثْتَ اصُولَ ٱلظَّالِمِينَ\",\n   \"tr\": \"wajtathathta usula alzzalimina\",\n   \"en\": \"eradicated the sources of the wrongdoers,\"\n  },\n  {\n   \"ar\": \"وَنَحْنُ نَقُولُ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَالَمِينَ\",\n   \"tr\": \"wa nahnu naqulu alhamdu lillahi rabbi al`alamina\",\n   \"en\": \"and we keep on saying, “All praise be to Allah the Lord of the worlds?”\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ انْتَ كَشَّافُ ْٱلكُرَبِ وَٱلْبَلْوَىٰ\",\n   \"tr\": \"allahumma anta kashshafu alkurabi walbalwa\",\n   \"en\": \"O Allah, You are verily the reliever from agonies and ordeals.\"\n  },\n  {\n   \"ar\": \"وَإِِلَيْكَ اسْتَعْدِي فَعِنْدَكَ ٱلْعَدْوَىٰ\",\n   \"tr\": \"wa ilayka asta`di fa`indaka al`adwa\",\n   \"en\": \"To You do I complain about the transgressions against me, for You alone are worthy of receiving complaints,\"\n  },\n  {\n   \"ar\": \"وَانْتَ رَبُّ ٱلآخِرَةِ وَٱلدُّنْيَا\",\n   \"tr\": \"wa anta rabbu al-akhirati walddunya\",\n   \"en\": \"and You are alone the Lord of the Hereafter and this world.\"\n  },\n  {\n   \"ar\": \"فَاغِثْ يَا غِيَاثَ ٱلْمُسْتَغِيثِينَ عُبَيْدَكَ ٱلْمُبْتَلَىٰ\",\n   \"tr\": \"fa'aghith ya ghiyatha almustaghithina `ubaydaka almubtala\",\n   \"en\": \"So, (please) aid Your agonized worthless servant, O Aide of those who seek aid,\"\n  },\n  {\n   \"ar\": \"وَارِهِ سَيِّدَهُ يَا شَدِيدَ ٱلْقُوَىٰ\",\n   \"tr\": \"wa arihi sayyidahu ya shadida alquwa\",\n   \"en\": \"grant him (i.e. Your servant) chance to see his master, O Lord of mighty prowess,\"\n  },\n  {\n   \"ar\": \"وَازِلْ عَنْهُ بِهِ ٱلاسَىٰ وَٱلْجَوَىٰ\",\n   \"tr\": \"wa azil `anhu bihi al-asa waljawa\",\n   \"en\": \"remove from him misfortune and anguish, in the name of his master,\"\n  },\n  {\n   \"ar\": \"وَبَرِّدْ غَلِيلَهُ يَا مَنْ عَلَىٰ ٱلْعَرْشِ ٱسْتَوَىٰ\",\n   \"tr\": \"wa barrid ghalilahu ya man `ala al`arshi istawa\",\n   \"en\": \"and satisfy his thirst, O He Who is established on the Throne\"\n  },\n  {\n   \"ar\": \"وَمَنْ إِِلَيْهِ ٱلرُّجْعَىٰ وَٱلْمُنْتَهَىٰ\",\n   \"tr\": \"wa man ilayhi alrruj`a walmuntaha\",\n   \"en\": \"and He to Whom is the return and the final goal.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ وَنَحْنُ عَبِيدُكَ ٱلتَّائِقُونَ إِلَىٰ وَلِيِّكَ\",\n   \"tr\": \"allahumma wa nahnu `abiduka altta'iquna ila waliyyika\",\n   \"en\": \"O Allah, we are Your servants who are fervently willing to meet Your vicegerent,\"\n  },\n  {\n   \"ar\": \"ٱلْمُذَكِّرِ بِكَ وَبِنَبِيِّكَ\",\n   \"tr\": \"almudhakkiri bika wa binabiyyika\",\n   \"en\": \"who reminds of You and Your Prophet;\"\n  },\n  {\n   \"ar\": \"خَلَقْتَهُ لَنَا عِصْمَةً وَمَلاَذاً\",\n   \"tr\": \"khalaqtahu lana `ismatan wa maladhan\",\n   \"en\": \"and whom You have created as haven and refuge for us,\"\n  },\n  {\n   \"ar\": \"وَاقَمْتَهُ لَنَا قِوَاماً وَمَعَاذاً\",\n   \"tr\": \"wa aqamtahu lana qiwaman wa ma`adhan\",\n   \"en\": \"You have appointed as foundation and source of protection for us,\"\n  },\n  {\n   \"ar\": \"وَجَعَلْتَهُ لِلْمُؤْمِنِينَ مِنَّا إِِمَاماً\",\n   \"tr\": \"wa ja`altahu lilmu'minina minna imaman\",\n   \"en\": \"and whom You have made to be the leader of the believers among us.\"\n  },\n  {\n   \"ar\": \"فَبَلِّغْهُ مِنَّا تَحِيَّةً وَسَلاَماً\",\n   \"tr\": \"faballighhu minna tahiyyatan wa salaman\",\n   \"en\": \"So, (please) convey to him greetings and salutations from us,\"\n  },\n  {\n   \"ar\": \"وَزِدْنَا بِذٰلِكَ يَا رَبِّ إِِكْرَاماً\",\n   \"tr\": \"wa zidna bidhalika ya rabbi ikraman\",\n   \"en\": \"endue us with more honor, O my Lord, through that,\"\n  },\n  {\n   \"ar\": \"وَٱجْعَلْ مُسْتَقَرَّهُ لَنَا مُسْتَقَرّاً وَمُقَاماً\",\n   \"tr\": \"waj`al mustaqarrahu lana mustaqarran wa muqaman\",\n   \"en\": \"decide his settlement among us to be settlement and dwelling for us,\"\n  },\n  {\n   \"ar\": \"وَاتْمِمْ نِعْمَتَكَ بِتَقْدِيـمِكَ إِِيَّاهُ امَامَنَا\",\n   \"tr\": \"wa atmim ni`mataka bitaqdimika iyyahu amamana\",\n   \"en\": \"and perfect Your bounty by making him occupy the leading position before us\"\n  },\n  {\n   \"ar\": \"حَتَّىٰ تُورِدَنَا جِنَانَكَ\",\n   \"tr\": \"hatta turidana jinanaka\",\n   \"en\": \"so that You shall allow us to enter the gardens of Your Paradise\"\n  },\n  {\n   \"ar\": \"وَمُرَافَقَةَ ٱلشُّهَدَاءِ مِنْ خُلَصَائِكَ\",\n   \"tr\": \"wa murafaqata alshshuhada'i min khulasa'ika\",\n   \"en\": \"and to accompany the martyrs from among Your elite ones.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ\",\n   \"tr\": \"allahumma salli `ala muhammadin wa ali muhammadin\",\n   \"en\": \"O Allah, (please) send blessings upon Muhammad and the Household of Muhammad;([1])\"\n  },\n  {\n   \"ar\": \"وَصَلِّ عَلَىٰ مُحَمَّدٍ جَدِّهِ وَرَسُولِكَ\",\n   \"tr\": \"wa salli `ala muhammadin jaddihi wa rasulika\",\n   \"en\": \"and send blessings upon Muhammad his grandfather and Your messenger;\"\n  },\n  {\n   \"ar\": \"ٱلسَّيِّدِ ٱلاكْبَرِ\",\n   \"tr\": \"alssayyidi al-akbari\",\n   \"en\": \"the senior master,\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ ابِيهِ ٱلسَّيِّدِ ٱلاصْغَرِ\",\n   \"tr\": \"wa `ala abihi alssayyidi al-asghari\",\n   \"en\": \"upon his father the junior master,\"\n  },\n  {\n   \"ar\": \"وَجَدَّتِهِ ٱلصِّدِّيقَةِ ٱلْكُبْرَىٰ\",\n   \"tr\": \"wa jaddatihi alssiddiqati alkubra\",\n   \"en\": \"upon his grandmother the grand veracious lady\"\n  },\n  {\n   \"ar\": \"فَاطِمَةَ بِنْتِ مُحَمَّدٍ\",\n   \"tr\": \"fatimata binti muhammadin\",\n   \"en\": \"Fatimah the daughter of Muhammad,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"slla allah `alihi wa alihi\",\n   \"en\": \"peace be upon him and his Household,\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ مَنِ ٱصْطَفَيْتَ مِنْ آبَائِهِ ٱلْبَرَرَةِ\",\n   \"tr\": \"wa `ala man istafayta min aba'ihi albararati\",\n   \"en\": \"upon his dutiful fathers whom You have chosen (over all others),\"\n  },\n  {\n   \"ar\": \"وَعَلَيْهِ افْضَلَ وَاكْمَلَ\",\n   \"tr\": \"wa `alayhi afdala wa akmala\",\n   \"en\": \"and upon him with such most favorable, most perfect,\"\n  },\n  {\n   \"ar\": \"وَاتَمَّ وَادْوَمَ\",\n   \"tr\": \"wa atamma wa adwama\",\n   \"en\": \"most thorough, most permanent,\"\n  },\n  {\n   \"ar\": \"وَاكْثَرَ وَاوْفَرَ\",\n   \"tr\": \"wa akthara wa awfara\",\n   \"en\": \"most abundant, and most plentiful\"\n  },\n  {\n   \"ar\": \"مَا صَلَّيْتَ عَلَىٰ احَدٍ مِنْ اصْفِيَائِكَ\",\n   \"tr\": \"ma sallayta `ala ahadin min asfiya'ika\",\n   \"en\": \"blessings that You have ever sent upon any of Your elite ones\"\n  },\n  {\n   \"ar\": \"وَخِيَرَتِكَ مِنْ خَلْقِكَ\",\n   \"tr\": \"wa khiyaratika min khalqika\",\n   \"en\": \"and well-chosen ones among Your creatures.\"\n  },\n  {\n   \"ar\": \"وَصَلِّ عَلَيْهِ صَلاَةً لاََ غَايَةَ لِعَدَدِهَا\",\n   \"tr\": \"wa salli `alayhi salatan la ghayata li`adadiha\",\n   \"en\": \"And (please) bless him with such blessings whose number is infinite,\"\n  },\n  {\n   \"ar\": \"وَلاَ نِهَايَةَ لِمَدَدِهَا\",\n   \"tr\": \"wa la nihayata limadadiha\",\n   \"en\": \"whose quantity is never-ending,\"\n  },\n  {\n   \"ar\": \"وَلاَ نَفَادَ لاِمَدِهَا\",\n   \"tr\": \"wa la nafada li'amadiha\",\n   \"en\": \"and whose time is interminable.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ وَاقِمْ بِهِ ٱلْحَقَّ\",\n   \"tr\": \"allahumma wa aqim bihi alhaqqa\",\n   \"en\": \"O Allah! Through him, establish all rights,\"\n  },\n  {\n   \"ar\": \"وَادْحِضْ بِهِ ٱلْبَاطِلَ\",\n   \"tr\": \"wa adhid bihi albatila\",\n   \"en\": \"refute the entire wrong,\"\n  },\n  {\n   \"ar\": \"وَادِلْ بِهِ اوْلِيَاءَكَ\",\n   \"tr\": \"wa adil bihi awliya'aka\",\n   \"en\": \"grant triumph to Your loyalists,\"\n  },\n  {\n   \"ar\": \"وَاذْلِلْ بِهِ اعْدَاءَكَ\",\n   \"tr\": \"wa adhlil bihi a`da'aka\",\n   \"en\": \"humiliate Your enemies,\"\n  },\n  {\n   \"ar\": \"وَصِلِ ٱللَّهُمَّ بَيْنَنَا وَبَيْنَهُ\",\n   \"tr\": \"wa sil allahumma baynana wa baynahu\",\n   \"en\": \"establish, O Allah, between him and us\"\n  },\n  {\n   \"ar\": \"وُصْلَةً تُؤَدِّي إِلَىٰ مُرَافَقَةِ سَلَفِهِ\",\n   \"tr\": \"wuslatan tu'addi ila murafaqati salafihi\",\n   \"en\": \"a connection that leads us to accompany his ancestors,\"\n  },\n  {\n   \"ar\": \"وَٱجْعَلْنَا مِمَّنْ يَاخُذُ بِحُجْزَتِهِمْ\",\n   \"tr\": \"waj`alna mimman ya'khudhu bihujzatihim\",\n   \"en\": \"include us with those who will take their vengeance\"\n  },\n  {\n   \"ar\": \"وَيَمْكُثُ فِي ظِلِّهِمْ\",\n   \"tr\": \"wa yamkuthu fi zillihim\",\n   \"en\": \"and keep constant under their shadow,\"\n  },\n  {\n   \"ar\": \"وَاعِنَّا عَلَىٰ تَادِيَةِ حُقُوقِهِ إِِلَيْهِ\",\n   \"tr\": \"wa a`inna `ala ta'diyati huquqihi ilayhi\",\n   \"en\": \"help us fulfill our duties towards him,\"\n  },\n  {\n   \"ar\": \"وَٱلِٱجْتِهَادِ فِي طَاعَتِهِ\",\n   \"tr\": \"walijtihadi fi ta`atihi\",\n   \"en\": \"exert all efforts in obedience to him\"\n  },\n  {\n   \"ar\": \"وَٱجْتِنَابِ مَعْصِيَتِهِ\",\n   \"tr\": \"wajtinabi ma`siyatihi\",\n   \"en\": \"and avoiding disobeying him,\"\n  },\n  {\n   \"ar\": \"وَٱمْنُنْ عَلَيْنَا بِرِضَاهُ\",\n   \"tr\": \"wamnun `alayna biridahu\",\n   \"en\": \"bestow upon us with the favor of attaining his pleasure,\"\n  },\n  {\n   \"ar\": \"وَهَبْ لَنَا رَافَتَهُ وَرَحْمَتَهُ\",\n   \"tr\": \"wa hab lana ra'fatahu wa rahmatahu\",\n   \"en\": \"and grant us his kindness, mercy,\"\n  },\n  {\n   \"ar\": \"وَدُعَاءَهُ وَخَيْرَهُ\",\n   \"tr\": \"wa du`a'ahu wa khayrahu\",\n   \"en\": \"prayer (for us), and his goodness\"\n  },\n  {\n   \"ar\": \"مَا نَنَالُ بِهِ سَعَةً مِنْ رَحْمَتِكَ\",\n   \"tr\": \"ma nanalu bihi sa`atan min rahmatika\",\n   \"en\": \"in an amount due to which we will gain a good deal of Your mercy\"\n  },\n  {\n   \"ar\": \"وَفَوْزاً عِنْدَكَ\",\n   \"tr\": \"wa fawzan `indaka\",\n   \"en\": \"and achievement with You.\"\n  },\n  {\n   \"ar\": \"وَٱجْعَلْ صَلاَتَنَا بِهِ مَقبُولَةً\",\n   \"tr\": \"waj`al salatana bihi maqbulatan\",\n   \"en\": \"And, through him, render our prayers admitted,\"\n  },\n  {\n   \"ar\": \"وَذُنُوبَنَا بِهِ مَغْفُورَةً\",\n   \"tr\": \"wa dhunubana bihi maghfuratan\",\n   \"en\": \"our sins forgiven,\"\n  },\n  {\n   \"ar\": \"وَدُعَاءَنَا بِهِ مُسْتَجَاباً\",\n   \"tr\": \"wa du`a'ana bihi mustajaban\",\n   \"en\": \"and our supplications responded.\"\n  },\n  {\n   \"ar\": \"وَٱجْعَلْ ارْزَاقَنَا بِهِ مَبْسُوطَةً\",\n   \"tr\": \"waj`al arzaqana bihi mabsutatan\",\n   \"en\": \"And, through him too, make our sustenance expanded for us,\"\n  },\n  {\n   \"ar\": \"وَهُمُومَنَا بِهِ مَكْفِيَّةً\",\n   \"tr\": \"wa humumana bihi makfiyyatan\",\n   \"en\": \"our distresses relieved,\"\n  },\n  {\n   \"ar\": \"وَحَوَائِجَنَا بِهِ مَقْضِيَّةً\",\n   \"tr\": \"wa hawa'ijana bihi maqdiyyatan\",\n   \"en\": \"and our needs granted.\"\n  },\n  {\n   \"ar\": \"وَاقْبِلْ إِِلَيْنَا بِوَجْهِكَ ٱلْكَرِيـمِ\",\n   \"tr\": \"wa aqbil ilayna biwajhika alkarimi\",\n   \"en\": \"And (please) receive us with Your Noble Face,\"\n  },\n  {\n   \"ar\": \"وَٱقْبَلْ تَقَرُّبَنَا إِِلَيْكَ\",\n   \"tr\": \"waqbal taqarrubana ilayka\",\n   \"en\": \"approve of our seeking nearness to You,\"\n  },\n  {\n   \"ar\": \"وَٱنْظُرْ إِِلَيْنَا نَظْرَةً رَحِيمَةً\",\n   \"tr\": \"wanzur ilayna nazratan rahimatan\",\n   \"en\": \"and have a merciful look at us\"\n  },\n  {\n   \"ar\": \"نَسْتَكْمِلُ بِهَا ٱلْكَرَامَةَ عِنْدَكَ\",\n   \"tr\": \"nastakmilu biha alkaramata `indaka\",\n   \"en\": \"by which we will win perfect honor with You;\"\n  },\n  {\n   \"ar\": \"ثُمَّ لاََ تَصْرِفْهَا عَنَّا بِجُودِكَ\",\n   \"tr\": \"thumma la tasrifha `anna bijudika\",\n   \"en\": \"and, after that, do not ever take it away from us, in the name of Your magnanimity,\"\n  },\n  {\n   \"ar\": \"وَٱسْقِنَا مِنْ حَوْضِ جَدِّهِ\",\n   \"tr\": \"wasqina min hawdi jaddihi\",\n   \"en\": \"and give us a drink from the Pond of his grandfather,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"may Allah bless him and his Household,\"\n  },\n  {\n   \"ar\": \"بِكَاسِهِ وَبِيَدِهِ\",\n   \"tr\": \"bika'sihi wa biyadihi\",\n   \"en\": \"from his own cup and with his own hand,\"\n  },\n  {\n   \"ar\": \"رَيّاً رَوِيّاً\",\n   \"tr\": \"rayyan rawiyyan\",\n   \"en\": \"such a replete, satiating,\"\n  },\n  {\n   \"ar\": \"هَنِيئاً سَائِغاً\",\n   \"tr\": \"hani'an sa'ighan\",\n   \"en\": \"pleasant, and wholesome drink\"\n  },\n  {\n   \"ar\": \"لاََ ظَمَا بَعْدَهُ\",\n   \"tr\": \"la zama'a ba`dahu\",\n   \"en\": \"after which we shall never suffer from thirst.\"\n  },\n  {\n   \"ar\": \"يَا ارْحَمَ ٱلرَّاحِمينَ\",\n   \"tr\": \"ya arhama alrrahimina\",\n   \"en\": \"O most merciful of all those who show mercy!\"\n  }\n ]\n}"