\": \"we are turning our faces toward you, seeking your intercession\"\n  },\n  {\n   \"ar\": \"وَتَوَسَّلْنَا بِكَ إِلَىٰ ٱللَّهِ\",\n   \"tr\": \"wa tawassalna bika ila allahi\",\n   \"en\": \"and your advocacy for us before Allah;\"\n  },\n  {\n   \"ar\": \"وَقَدَّمْنَاكَ بَيْنَ يَدَيْ حَاجَاتِنَا\",\n   \"tr\": \"wa qaddamnaka bayna yaday hajatina\",\n   \"en\": \"and we are presenting you [as our intermediary] for the settlement of our needs.\"\n  },\n  {\n   \"ar\": \"يَا وَجِيهاً عِنْدَ ٱللَّهِ\",\n   \"tr\": \"ya wajihan `inda allahi\",\n   \"en\": \"O well-esteemed with Allah,\"\n  },\n  {\n   \"ar\": \"إِشْفَعْ لَنَا عِنْدَ ٱللَّهِ\",\n   \"tr\": \"ishfa` lana `inda allahi\",\n   \"en\": \"intercede for us before Allah.\"\n  },\n  {\n   \"ar\": \"يَا سَادَتِي وَمَوَالِيَّ\",\n   \"tr\": \"ya sadati wa mawaliyya\",\n   \"en\": \"O my chiefs and masters!\"\n  },\n  {\n   \"ar\": \"إِنِّي تَوَجَّهْتُ بِكُمْ\",\n   \"tr\": \"inni tawajjahtu bikum\",\n   \"en\": \"I am turning my face toward Allah in the names of you [all],\"\n  },\n  {\n   \"ar\": \"ائِمَّتِي وَعُدَّتِي\",\n   \"tr\": \"a'immati wa `uddati\",\n   \"en\": \"for you are my leaders and my supporters\"\n  },\n  {\n   \"ar\": \"لِيَوْمِ فَقْرِي وَحَاجَتِي\",\n   \"tr\": \"liyawmi faqri wa hajati\",\n   \"en\": \"on the day of my destitution and neediness\"\n  },\n  {\n   \"ar\": \"إِلَىٰ ٱللَّهِ\",\n   \"tr\": \"ila allahi\",\n   \"en\": \"before Allah.\"\n  },\n  {\n   \"ar\": \"وَتَوَسَّلْتُ بِكُمْ إِلَىٰ ٱللَّهِ\",\n   \"tr\": \"wa tawassaltu bikum ila allahi\",\n   \"en\": \"I am seeking your advocacy for me before Allah\"\n  },\n  {\n   \"ar\": \"وَٱسْتَشْفَعْتُ بِكُمْ إِلَىٰ ٱللَّهِ\",\n   \"tr\": \"wastashfa`tu bikum ila allahi\",\n   \"en\": \"and seeking your intercession for me before Allah;\"\n  },\n  {\n   \"ar\": \"فَٱشْفَعُوا لِي عِنْدَ ٱللَّهِ\",\n   \"tr\": \"fashfa`u li `inda allahi\",\n   \"en\": \"so, (please) intercede for me before Allah\"\n  },\n  {\n   \"ar\": \"وَٱسْتَنْقِذُونِي مِنْ ذُنُوبِي عِنْدَ ٱللَّهِ\",\n   \"tr\": \"wastanqidhuni min dhunubi `inda allahi\",\n   \"en\": \"and save me from my sins before Allah,\"\n  },\n  {\n   \"ar\": \"فَإنَّكُمْ وَسيلَتِي إِلَىٰ ٱللَّهِ\",\n   \"tr\": \"fa'innakum wasilati ila allahi\",\n   \"en\": \"for you are my means to Allah\"\n  },\n  {\n   \"ar\": \"وَبِحُبِّكُمْ وَبِقُرْبِكُمْ ارْجُو نَجَاةً مِنَ ٱللَّهِ\",\n   \"tr\": \"wa bihubbikum wa biqurbikum arju najatan mina allahi\",\n   \"en\": \"and through my love for you and my seeking nearness to you do I hope for salvation from Allah.\"\n  },\n  {\n   \"ar\": \"فَكُونُوا عِنْدَ ٱللَّهِ رَجَائِي\",\n   \"tr\": \"fakunu `inda allahi raja'i\",\n   \"en\": \"So, be my hope before Allah.\"\n  },\n  {\n   \"ar\": \"يَا سَادَتِي يَا اوْلِيَاءَ ٱللَّهِ\",\n   \"tr\": \"ya sadati ya awliya'a allahi\",\n   \"en\": \"O my masters! O Allah’s intimate servants!\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِمْ اجْمَعينَ\",\n   \"tr\": \"salla allahu `alayhim ajma`ina\",\n   \"en\": \"May Allah bless you all\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ اعْدَاءَ ٱللَّهِ ظَالِمِيهِمْ\",\n   \"tr\": \"wa la`ana allahu a`da'a allahi zalimihim\",\n   \"en\": \"and may Allah curse the enemies of Allah; those who wronged you,\"\n  },\n  {\n   \"ar\": \"مِنَ ٱلاوَّلِينَ وَٱلآخِرِينَ\",\n   \"tr\": \"mina al-awwalina wal-akhirina\",\n   \"en\": \"from the past and the last generations.\"\n  },\n  {\n   \"ar\": \"آمِينَ رَبَّ ٱلْعَالَمينَ\",\n   \"tr\": \"amina rabba al`alamina\",\n   \"en\": \"Respond to us, O Lord of the Worlds!\"\n  }\n ]\n}"