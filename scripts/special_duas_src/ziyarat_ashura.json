"{\n \"url\": \"https://www.duas.org/ziyarat-imam-hussain-ashura.html\",\n \"title\": \"Ziyarat Ashura - Imam Hussain(as) - Duas.org\",\n \"meta\": {\n  \"Type\": \"ZIYARAT\",\n  \"Attributed to\": \"Imam Hussain (as)\",\n  \"Recommended for\": \"Ashura\",\n  \"Purpose\": \"Removing Calamities\"\n },\n \"segCount\": 137,\n \"missTR\": 1,\n \"missEN\": 1,\n \"totalArChars\": 5692,\n \"instructions\": [\n  \"You may then repeat the following Laan ** one hundred times (or once)\",\n  \"You may then repeat the following salam ** one hundred times (or once):\",\n  \"You may then say the following :\",\n  \"You may then prostrate yourself and say the following words :\",\n  \"Dua to be recited after Ziyarat Ashura\"\n ],\n \"segments\": [\n  {\n   \"ar\": \"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ\",\n   \"tr\": \"\",\n   \"en\": \"\"\n  },\n  {\n   \"ar\": \"بِسْمِ اللهِ الرّحْمٰنِ الرّحِیْمِ\",\n   \"tr\": \"bismillahi alrrahmani alrraheemi\",\n   \"en\": \"In the name of Allah, the Most Merciful, the Most Compassionate\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا أَبَا عَبْدِ ٱللَّهِ\",\n   \"tr\": \"alssalamu `alayka ya aba `abdillahi\",\n   \"en\": \"Peace be upon you, O Abu-`Abdullah.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ\",\n   \"tr\": \"alssalamu `alayka yabna rasuli allahi\",\n   \"en\": \"Peace be upon you, O son of Allah’s Messenger.\"\n  },\n  {\n   \"ar\": \"السَّلاَمُ عَلَيكَ يَا خِيَرَةِ ٱللَّهِ وَٱبْنَ خَيرَتِهِ\",\n   \"tr\": \"alssalamu `alayka ya khiyarata allahi wabna khiyaratihi\",\n   \"en\": \"Peace be upon you, O choicest of Allah and son of His choicest.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا بْنَ أَمِيرِ ٱلْمُؤْمِنِينَ\",\n   \"tr\": \"alssalamu `alayka yabna amiri almu'minina\",\n   \"en\": \"Peace be upon you, O son of the Commander of the Faithful\"\n  },\n  {\n   \"ar\": \"وَٱبْنَ سَيِّدِ ٱلْوَصِيِّينَ\",\n   \"tr\": \"wabna sayyidi alwasiyyina\",\n   \"en\": \"and son of the chief of the Prophets’ successors.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا بْنَ فَاطِمَةَ\",\n   \"tr\": \"alssalamu `alayka yabna fatimata\",\n   \"en\": \"Peace be upon you, O son of Fatimah\"\n  },\n  {\n   \"ar\": \"سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ\",\n   \"tr\": \"sayyidati nisa'i al`alamina\",\n   \"en\": \"the doyenne of the women of the worlds.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا ثَارَ ٱللَّهِ وَٱبْنَ ثَارِهِ وَٱلْوِتْرَ ٱلْمَوْتُورَ\",\n   \"tr\": \"alssalamu `alayka ya thara allahi wabna tharihi walwitra almawtura\",\n   \"en\": \"Peace be upon you, O vengeance of Allah, son of His vengeance, and the unavenged so far.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ وَعَلَىٰ ٱلأَرْوَاحِ ٱلَّتِي حَلَّتْ بِفِنَائِكَ\",\n   \"tr\": \"alssalamu `alayka wa `ala al-arwahi allati hallat bifina'ika\",\n   \"en\": \"Peace be upon you and upon the souls that resided in your courtyard.\"\n  },\n  {\n   \"ar\": \"عَلَيْكُمْ مِنِّي جَمِيعاً سَلاَمُ ٱللَّهِ أَبَداً\",\n   \"tr\": \"`alaykum minni jami`an salamu allahi abadan\",\n   \"en\": \"Peace of Allah be upon all of you from me forever\"\n  },\n  {\n   \"ar\": \"مَا بَقيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ\",\n   \"tr\": \"ma baqitu wa baqiya allaylu walnnaharu\",\n   \"en\": \"as long as I am existent and as long as there are day and night.\"\n  },\n  {\n   \"ar\": \"يَا أَبَا عَبْدِ ٱللَّهِ\",\n   \"tr\": \"ya aba `abdillahi\",\n   \"en\": \"O Abu-`Abdullah,\"\n  },\n  {\n   \"ar\": \"لَقَدْ عَظُمَتِ ٱلرَّزِيَّةُ\",\n   \"tr\": \"laqad `azumat alrraziyyatu\",\n   \"en\": \"unbearable is the sorrow\"\n  },\n  {\n   \"ar\": \"وَجَلَّتْ وَعَظُمَتِ ٱلْمُصيبَةُ بِكَ\",\n   \"tr\": \"wa jallat wa `azumat almusibatu bika\",\n   \"en\": \"and excruciating and unbearable is the misfortune of you\"\n  },\n  {\n   \"ar\": \"عَلَيْنَا وَعَلَىٰ جَمِيعِ أَهْلِ ٱلإِسْلاَمِ\",\n   \"tr\": \"`alayna wa `ala jami`i ahli al-islami\",\n   \"en\": \"for us and for all the people of Islam.\"\n  },\n  {\n   \"ar\": \"وَجَلَّتْ وَعَظُمَتْ مُصيبَتُكَ\",\n   \"tr\": \"wa jallat wa `azumat musibatuka\",\n   \"en\": \"Excruciating and unbearable has been your misfortune\"\n  },\n  {\n   \"ar\": \"فِي ٱلسَّمَاوَاتِ عَلَىٰ جَمِيعِ أَهْلِ ٱلسَّمَاوَاتِ\",\n   \"tr\": \"fi alssamawati `ala jami`i ahli alssamawati\",\n   \"en\": \"in the heavens for all the inhabitants of the heavens.\"\n  },\n  {\n   \"ar\": \"فَلَعَنَ ٱللَّهُ أُمَّةً أَسَّسَتْ أَسَاسَ ٱلظُّلْمِ وَٱلْجَوْرِ عَلَيْكُمْ أَهْلَ ٱلْبَيْتِ\",\n   \"tr\": \"fala`ana allahu ummatan assasat asasa alzzulmi waljawri `alaykum ahla albayti\",\n   \"en\": \"So, may Allah curse the people who laid the basis of persecution and wronging against you, O Members of the Household.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ أُمَّةً دَفَعَتْكُمْ عَنْ مَقَامِكُمْ\",\n   \"tr\": \"wa la`ana allahu ummatan dafa`atkum `an maqamikum\",\n   \"en\": \"May Allah curse the people who drove you away from your position\"\n  },\n  {\n   \"ar\": \"وَأَزَالَتْكُمْ عَنْ مَرَاتِبِكُمُ ٱلَّتِي رَتَّبَكُمُ ٱللَّهُ فِيهَا\",\n   \"tr\": \"wa azalatkum `an maratibikum allati rattabakum allahu fiha\",\n   \"en\": \"and removed you away from your ranks that Allah has put you in.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ أُمَّةً قَتَلَتْكُمْ\",\n   \"tr\": \"wa la`ana allahu ummatan qatalatkum\",\n   \"en\": \"May Allah curse the people who slew you.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ ٱلْمُمَهِّدِينَ لَهُمْ\",\n   \"tr\": \"wa la`ana allahu almumahhidina lahum\",\n   \"en\": \"May Allah curse those who paved the way for them to do so\"\n  },\n  {\n   \"ar\": \"بِٱلتَّمْكِينِ مِنْ قِتَالِكُمْ\",\n   \"tr\": \"bilttamkini min qitalikum\",\n   \"en\": \"and who made possible for them to fight against you.\"\n  },\n  {\n   \"ar\": \"بَرِئْتُ إِلَىٰ ٱللَّهِ وَإِلَيْكُمْ مِنْهُمْ\",\n   \"tr\": \"bari'tu ila allahi wa ilaykum minhum\",\n   \"en\": \"I repudiate them in the presence of Allah and You\"\n  },\n  {\n   \"ar\": \"وَمِنْ أَشْيَاعِهِمْ وَأَتْبَاعِهِمْ وَأَوْلِيَائِهِمْ\",\n   \"tr\": \"wa min ashya`ihim wa atba`ihim wa awliya'ihim\",\n   \"en\": \"and I repudiate their devotees, followers, and loyalists.\"\n  },\n  {\n   \"ar\": \"يَا أَبَا عَبْدِ ٱللَّهِ\",\n   \"tr\": \"ya aba `abdillahi\",\n   \"en\": \"O Abu-`Abdullah,\"\n  },\n  {\n   \"ar\": \"إِنِّي سِلْمٌ لِمَنْ سَالَمَكُمْ\",\n   \"tr\": \"inni silmun liman salamakum\",\n   \"en\": \"I am at peace with those who are at peace with you\"\n  },\n  {\n   \"ar\": \"وَحَرْبٌ لِمَنْ حَارَبَكُمْ إِلَىٰ يَوْمِ ٱلْقِيَامَةِ\",\n   \"tr\": \"wa harbun liman harabakum ila yawmi alqiyamati\",\n   \"en\": \"and I am at war against those who have fought against you up to the Resurrection Day.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ آلَ زِيَادٍ وَآلَ مَرْوَانَ\",\n   \"tr\": \"wa la`ana allahu ala ziyadin wa ala marwana\",\n   \"en\": \"May Allah also curse the family of Ziyad and the family of Marwan.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ بَنِي أُمَيَّةَ قَاطِبَةً\",\n   \"tr\": \"wa la`ana allahu bani umayyata qatibatan\",\n   \"en\": \"May Allah also curse the descendants of Umayyah altogether.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ ٱبْنَ مَرْجَانَةَ\",\n   \"tr\": \"wa la`ana allahu ibna marjanata\",\n   \"en\": \"May Allah also curse the son of Marjanah.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ عُمَرَ بْنَ سَعْدٍ\",\n   \"tr\": \"wa la`ana allahu `umara bna sa`din\",\n   \"en\": \"May Allah also curse `Umar the son of Sa`d.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ شِمْراً\",\n   \"tr\": \"wa la`ana allahu shimran\",\n   \"en\": \"May Allah also curse Shimr.\"\n  },\n  {\n   \"ar\": \"وَلَعَنَ ٱللَّهُ أُمَّةً أَسْرَجَتْ وَأَلْجَمَتْ\",\n   \"tr\": \"wa la`ana allahu ummatan asrajat wa aljamat\",\n   \"en\": \"May Allah also curse the people who saddled up, gave reins to their horses,\"\n  },\n  {\n   \"ar\": \"وَتَنَقَّبَتْ لِقِتَالِكَ\",\n   \"tr\": \"wa tanaqqabat liqitalika\",\n   \"en\": \"and masked their faces in preparation for fighting against you.\"\n  },\n  {\n   \"ar\": \"بِأَبِي أَنْتَ وَأُمِّي\",\n   \"tr\": \"bi'abi anta wa ummi\",\n   \"en\": \"May my father and mother be ransoms for you.\"\n  },\n  {\n   \"ar\": \"لَقَدْ عَظُمَ مُصَابِي بِكَ\",\n   \"tr\": \"laqad `azuma musabi bika\",\n   \"en\": \"Extremely insufferable is my commiserations with you;\"\n  },\n  {\n   \"ar\": \"فَأَسْأَلُ ٱللَّهَ ٱلَّذِي أَكْرَمَ مَقَامَكَ وَأَكْرَمَنِي بِكَ\",\n   \"tr\": \"fa'as'alu allaha alladhi akrama maqamaka wa akramani bika\",\n   \"en\": \"so, I beseech Allah Who has honored your position and honored me because of you\"\n  },\n  {\n   \"ar\": \"أَنْ يَرْزُقَنِي طَلَبَ ثَأْرِكَ\",\n   \"tr\": \"an yarzuqani talaba tha'rika\",\n   \"en\": \"to endue me with the chance to avenge you\"\n  },\n  {\n   \"ar\": \"مَعَ إِمَامٍ مَنْصُورٍ مِنْ أَهْلِ بَيْتِ مُحَمَّدٍ\",\n   \"tr\": \"ma`a imamin mansurin min ahli bayti muhammadin\",\n   \"en\": \"with a (Divinely) supported leader from the Household of Muhammad,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"peace of Allah be upon him and his Household.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱجْعَلْنِي عِنْدَكَ وَجِيهاً\",\n   \"tr\": \"allahumma ij`alni `indaka wajihan\",\n   \"en\": \"O Allah, (please) make me illustrious in Your sight\"\n  },\n  {\n   \"ar\": \"بِٱلْحُسَيْنِ عَلَيْهِ ٱلسَّلاَمُ فِي ٱلدُّنْيَا وَٱلآخِرَةِ\",\n   \"tr\": \"bilhusayni `alayhi alssalamu fi alddunya wal-akhirati\",\n   \"en\": \"in the name of al-Husayn, peace be upon him, in this world and in the Hereafter.\"\n  },\n  {\n   \"ar\": \"يَا أَبَا عَبْدِ ٱللَّهِ\",\n   \"tr\": \"ya aba `abdillahi\",\n   \"en\": \"O Abu-`Abdullah,\"\n  },\n  {\n   \"ar\": \"إِنِّي أَتَقَرَّبُ إِلَىٰ ٱللَّهِ وَإِلَىٰ رَسُولِهِ\",\n   \"tr\": \"inni ataqarrabu ila allahi wa ila rasulihi\",\n   \"en\": \"I do seek nearness to Allah, to His Messenger,\"\n  },\n  {\n   \"ar\": \"وَإِلَىٰ أَمِيرِ ٱلْمُؤْمِنِينَ وَإِلَىٰ فَاطِمَةَ\",\n   \"tr\": \"wa ila amiri almu'minina wa ila fatimata\",\n   \"en\": \"to the Commander of the Faithful, to Fatimah,\"\n  },\n  {\n   \"ar\": \"وَإِلَىٰ ٱلْحَسَنِ وَإِلَيْكَ بِمُوَالاَتِكَ\",\n   \"tr\": \"wa ila alhasani wa ilayka bimuwalatika\",\n   \"en\": \"to al-Hasan, and to you by means of loyalty to you\"\n  },\n  {\n   \"ar\": \"وَبِٱلْبَرَاءَةِ (مِمَّنْ قَاتَلَكَ\",\n   \"tr\": \"wa bilbara'ati (mimman qatalaka\",\n   \"en\": \"and by means of repudiation of those who fought against you\"\n  },\n  {\n   \"ar\": \"وَنَصَبَ لَكَ ٱلْحَرْبَ\",\n   \"tr\": \"wa nasaba laka alharba\",\n   \"en\": \"and incurred your hostility,\"\n  },\n  {\n   \"ar\": \"وَبِٱلْبَرَاءَةِ مِمَّنْ أَسَّسَ أَسَاسَ ٱلظُّلْمِ وَٱلْجَوْرِ عَلَيْكُمْ\",\n   \"tr\": \"wa bilbara'ati mimman assasa asasa alzzulmi waljawri `alaykum\",\n   \"en\": \"and repudiation of those who laid the basis of persecution and wronging against you all.\"\n  },\n  {\n   \"ar\": \"وَأَبْرَأُ إِلَىٰ ٱللَّهِ وَإِلَىٰ رَسُولِهِ)\",\n   \"tr\": \"wa abra'u ila allahi wa ila rasulihi)\",\n   \"en\": \"I also repudiate, in the presence of Allah and His Messenger,\"\n  },\n  {\n   \"ar\": \"مِمَّنْ أَسَّسَ أَسَاسَ ذٰلِكَ\",\n   \"tr\": \"mimman assasa asasa dhalika\",\n   \"en\": \"those who laid the basis of all that,\"\n  },\n  {\n   \"ar\": \"وَبَنَىٰ عَلَيْهِ بُنْيَانَهُ\",\n   \"tr\": \"wa bana `alayhi bunyanahu\",\n   \"en\": \"established their foundations on it,\"\n  },\n  {\n   \"ar\": \"وَجَرَىٰ فِي ظُلْمِهِ وَجَوْرِهِ عَلَيْكُمْ وَعلىٰ أَشْيَاعِكُمْ\",\n   \"tr\": \"wa jara fi zulmihi wa jawrihi `alaykum wa `ala ashya`ikum\",\n   \"en\": \"and continued in wronging and persecuting you and your adherents.\"\n  },\n  {\n   \"ar\": \"بَرِئْتُ إِلَىٰ ٱللَّهِ وَإِلَيْكُمْ مِنْهُمْ\",\n   \"tr\": \"bari'tu ila allahi wa ilaykum minhum\",\n   \"en\": \"In the presence of Allah and you all do I repudiate these.\"\n  },\n  {\n   \"ar\": \"وَأَتَقَرَّبُ إِلَىٰ ٱللَّهِ ثُمَّ إِلَيْكُمْ\",\n   \"tr\": \"wa ataqarrabu ila allahi thumma ilaykum\",\n   \"en\": \"And I seek nearness to Allah and then to you all\"\n  },\n  {\n   \"ar\": \"بِمُوَالاَتِكُمْ وَمُوَالاَةِ وَلِيِّكُمْ\",\n   \"tr\": \"bimuwalatikum wa muwalati waliyyikum\",\n   \"en\": \"by means of declaring loyalty to you and to your loyalists\"\n  },\n  {\n   \"ar\": \"وَبِٱلْبَرَاءَةِ مِنْ أَعْدَائِكُمْ\",\n   \"tr\": \"wa bilbara'ati min a`da'ikum\",\n   \"en\": \"and declaring repudiation of your enemies\"\n  },\n  {\n   \"ar\": \"وَٱلنَّاصِبِينَ لَكُمُ ٱلْحَرْبَ\",\n   \"tr\": \"walnnasibina lakum alharba\",\n   \"en\": \"and those who incur animosity of you\"\n  },\n  {\n   \"ar\": \"وَبِٱلْبَرَاءَةِ مِنْ أَشْيَاعِهِمْ وَأَتْبَاعِهِمْ\",\n   \"tr\": \"wa bilbara'ati min ashya`ihim wa atba`ihim\",\n   \"en\": \"and repudiation of their adherents and followers.\"\n  },\n  {\n   \"ar\": \"إِنِّي سِلْمٌ لِمَنْ سَالَمَكُمْ\",\n   \"tr\": \"inni silmun liman salamakum\",\n   \"en\": \"I am verily at peace with those who have been at peace with you,\"\n  },\n  {\n   \"ar\": \"وَحَرْبٌ لِمَنْ حَارَبَكُمْ\",\n   \"tr\": \"wa harbun liman harabakum\",\n   \"en\": \"I am at war against those who fought against you,\"\n  },\n  {\n   \"ar\": \"وَوَلِيٌّ لِمَنْ وَالاَكُمْ\",\n   \"tr\": \"wa waliyyun liman walakum\",\n   \"en\": \"loyalist to those who have been loyalist to you,\"\n  },\n  {\n   \"ar\": \"وَعَدُوٌّ لِمَنْ عَادَاكُمْ\",\n   \"tr\": \"wa `aduwwun liman `adakum\",\n   \"en\": \"and enemy of those who have shown enmity towards you.\"\n  },\n  {\n   \"ar\": \"فَأَسْأَلُ ٱللَّهَ ٱلَّذِي أَكْرَمَنِي بِمَعْرِفَتِكُمْ\",\n   \"tr\": \"fa'as'alu allaha alladhi akramani bima`rifatikum\",\n   \"en\": \"So, I beseech Allah Who has endued me with the honor of recognizing you\"\n  },\n  {\n   \"ar\": \"وَمَعْرِفَةِ أَوْلِيَائِكُمْ\",\n   \"tr\": \"wa ma`rifati awliya'ikum\",\n   \"en\": \"and recognizing your loyalists\"\n  },\n  {\n   \"ar\": \"وَرَزَقَنِيَ ٱلْبَرَاءَةَ مِنْ أَعْدَائِكُمْ\",\n   \"tr\": \"wa razaqani albara'ata min a`da'ikum\",\n   \"en\": \"and Who conferred upon me with repudiation of your enemies,\"\n  },\n  {\n   \"ar\": \"أَنْ يَجْعَلَنِي مَعَكُمْ فِي ٱلدُّنْيَا وَٱلآخِرَةِ\",\n   \"tr\": \"an yaj`alani ma`akum fi alddunya wal-akhirati\",\n   \"en\": \"to include me with you in this world and in the Hereafter\"\n  },\n  {\n   \"ar\": \"وَأَنْ يُثَبِّتَ لِي عِنْدَكُمْ قَدَمَ صِدْقٍ\",\n   \"tr\": \"wa an yuthabbita li `indakum qadama sidqin\",\n   \"en\": \"and to make firm step of honesty for me with you\"\n  },\n  {\n   \"ar\": \"فِي ٱلدُّنْيَا وَٱلآخِرَةِ\",\n   \"tr\": \"fi alddunya wal-akhirati\",\n   \"en\": \"in this world and in the Hereafter.\"\n  },\n  {\n   \"ar\": \"وَأَسْأَلُهُ أَنْ يُبَلِّغَنِيَ ٱلْمَقَامَ ٱلْمَحْمُودَ لَكُمْ عِنْدَ ٱللَّهِ\",\n   \"tr\": \"wa as'aluhu an yuballighani almaqama almahmuda lakum `inda allahi\",\n   \"en\": \"I also beseech Him to make me attain the praiseworthy status that you enjoy with Allah\"\n  },\n  {\n   \"ar\": \"وَأَنْ يَرْزُقَنِي طَلَبَ ثَأْرِي\",\n   \"tr\": \"wa an yarzuqani talaba tha'ri\",\n   \"en\": \"and to bestow upon me with the chance to take my own vengeance\"\n  },\n  {\n   \"ar\": \"مَعَ إِمَامِ هُدىًٰ ظَاهِرٍ\",\n   \"tr\": \"ma`a imami hudan zahirin\",\n   \"en\": \"with a leader of true guidance who is (Divinely) sustained\"\n  },\n  {\n   \"ar\": \"نَاطِقٍ بِٱلْحَقِّ مِنْكُمْ\",\n   \"tr\": \"natiqin bilhaqqi minkum\",\n   \"en\": \"and expressing the truth from among you.\"\n  },\n  {\n   \"ar\": \"وَأَسْأَلُ ٱللَّهَ بِحَقِّكُمْ\",\n   \"tr\": \"wa as'alu allaha bihaqqikum\",\n   \"en\": \"I also beseech Allah in your names\"\n  },\n  {\n   \"ar\": \"وَبِٱلشَّأْنِ ٱلَّذِي لَكُمْ عِنْدَهُ\",\n   \"tr\": \"wa bilshsha'ni alladhi lakum `indahu\",\n   \"en\": \"and in the name of the standing that you enjoy with Him\"\n  },\n  {\n   \"ar\": \"أَنْ يُعْطِيَنِي بِمُصَابِي بِكُمْ\",\n   \"tr\": \"an yu`tiyani bimusabi bikum\",\n   \"en\": \"to recompense me for my commiserations for you\"\n  },\n  {\n   \"ar\": \"أَفْضَلَ مَا يُعْطِي مُصَاباً بِمُصِيبَتِهِ\",\n   \"tr\": \"afdala ma yu`ti musaban bimusibatihi\",\n   \"en\": \"with the most favorite thing that He ever gives as compensation for misfortunes that has afflicted anyone.\"\n  },\n  {\n   \"ar\": \"مُصِيبَةً مَا أَعْظَمَهَا\",\n   \"tr\": \"musibatan ma a`zamaha\",\n   \"en\": \"(Your) misfortune has been so astounding\"\n  },\n  {\n   \"ar\": \"وَأَعْظَمَ رَزِيَّتَهَا فِي ٱلإِسْلاَمِ\",\n   \"tr\": \"wa a`zama raziyyataha fi al-islami\",\n   \"en\": \"and so catastrophic for Islam\"\n  },\n  {\n   \"ar\": \"وَفِي جَمِيعِ ٱلسَّمَاوَاتِ وَٱلأَرْضِ\",\n   \"tr\": \"wa fi jami`i alssamawati wal-ardi\",\n   \"en\": \"and for all the heavens and the entire earth.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱجْعَلْنِي فِي مَقَامِي هٰذَا\",\n   \"tr\": \"allahumma ij`alni fi maqami hadha\",\n   \"en\": \"O Allah, (please) make me in this situation of mine\"\n  },\n  {\n   \"ar\": \"مِمَّنْ تَنَالُهُ مِنْكَ صَلَوَاتٌ وَرَحْمَةٌ وَمَغْفِرَةٌ\",\n   \"tr\": \"mimman tanaluhu minka salawatun wa rahmatun wa maghfiratun\",\n   \"en\": \"one of those who receive blessings, mercy, and forgiveness from You.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱجْعَلْ مَحْيَايَ مَحْيَا مُحَمَّدٍ وَآلِ مُحَمَّدٍ\",\n   \"tr\": \"allahumma ij`al mahyaya mahya muhammadin wa ali muhammadin\",\n   \"en\": \"O Allah, (please) make me live my lifetime in the same way as Muhammad and Muhammad’s Household lived\"\n  },\n  {\n   \"ar\": \"وَمَمَاتِي مَمَاتَ مُحَمَّدٍ وَآلِ مُحَمَّدٍ\",\n   \"tr\": \"wa mamati mamata muhammadin wa ali muhammadin\",\n   \"en\": \"and make me die on the same principles on which Muhammad and Muhammad’s Household died.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ إِنَّ هٰذَا يَوْمٌ\",\n   \"tr\": \"allahumma inna hadha yawmun\",\n   \"en\": \"O Allah, this day\"\n  },\n  {\n   \"ar\": \"تَبَرَّكَتْ بِهِ بَنُو أُمَيَّةَ\",\n   \"tr\": \"tabarrakat bihi banu umayyata\",\n   \"en\": \"has been regarded as blessed day by the descendants of Umayyah\"\n  },\n  {\n   \"ar\": \"وَٱبْنُ آكِلَةِ ٱلأَكبَادِ\",\n   \"tr\": \"wabnu akilati al-akbadi\",\n   \"en\": \"and by the son of the liver-eater woman,\"\n  },\n  {\n   \"ar\": \"ٱللَّعِينُ ٱبْنُ ٱللَّعِينِ\",\n   \"tr\": \"alla`inu ibnu alla`ini\",\n   \"en\": \"the accursed and son of the accursed\"\n  },\n  {\n   \"ar\": \"عَلَىٰ لِسَانِكَ وَلِسَانِ نَبِيِّكَ\",\n   \"tr\": \"`ala lisanika wa lisani nabiyyika\",\n   \"en\": \"by the tongue of You and by the tongue of Your Prophet,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"Allah’s peace be upon him,\"\n  },\n  {\n   \"ar\": \"فِي كُلِّ مَوْطِنٍ وَمَوْقِفٍ\",\n   \"tr\": \"fi kulli mawtinin wa mawqifin\",\n   \"en\": \"on every occasion and in every situation,\"\n  },\n  {\n   \"ar\": \"وَقَفَ فِيهِ نَبِيُّكَ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"waqafa fihi nabiyyuka salla allahu `alayhi wa alihi\",\n   \"en\": \"which Your Prophet, Allah’s peace be upon him, attended.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱلْعَنْ أَبَا سُفْيَانَ وَمُعَاوِيَةَ وَيَزيدَ بْنَ مُعَاوِيَةَ\",\n   \"tr\": \"allahumma il`an aba sufyana wa mu`awiyata wa yazida bna mu`awiyata\",\n   \"en\": \"O Allah, pour curses upon Abu-Sufyan, Mu`awiyah, and Yazid son of Mu`awiyah.\"\n  },\n  {\n   \"ar\": \"عَلَيْهِمْ مِنْكَ ٱللَّعْنَةُ أَبَدَ ٱلآبِدِينَ\",\n   \"tr\": \"`alayhim minka alla`natu abada al-abidina\",\n   \"en\": \"May Your curse be upon them incessantly and everlastingly.\"\n  },\n  {\n   \"ar\": \"وَهٰذَا يَوْمٌ فَرِحَتْ بِهِ آلُ زِيَادٍ وَآلُ مَرْوَانَ\",\n   \"tr\": \"wa hadha yawmun farihat bihi alu ziyadin wa alu marwana\",\n   \"en\": \"This is the day on which the family of Ziyad and the family of Marwan gloated\"\n  },\n  {\n   \"ar\": \"بِقَتْلِهِمُ ٱلْحُسَيْنَ صَلَوَاتُ ٱللَّهِ عَلَيْهِ\",\n   \"tr\": \"biqatlihim alhusayna salawatu allahi `alayhi\",\n   \"en\": \"because they had killed al-Husayn, Allah’s blessings be upon him.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ فَضَاعِفْ عَلَيْهِمُ ٱللَّعْنَ مِنْكَ\",\n   \"tr\": \"allahumma fada`if `alayhim alla`na minka\",\n   \"en\": \"So, O Allah, pour frequent curses upon them\"\n  },\n  {\n   \"ar\": \"وَٱلْعَذَابَ (ٱلأَلِيمَ)\",\n   \"tr\": \"wal`adhaba (al-alima)\",\n   \"en\": \"and double for them the painful chastisement.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ إِنِّي أَتَقَرَّبُ إِلَيْكَ فِي هٰذَا ٱلْيَوْمِ\",\n   \"tr\": \"allahumma inni ataqarrabu ilayka fi hadha alyawmi\",\n   \"en\": \"O Allah, I do seek nearness to You on this day,\"\n  },\n  {\n   \"ar\": \"وَفِي مَوْقِفِي هٰذَا\",\n   \"tr\": \"wa fi mawqifi hadha\",\n   \"en\": \"on this occasion,\"\n  },\n  {\n   \"ar\": \"وَأَيَّامِ حَيَاتِي\",\n   \"tr\": \"wa ayyami hayati\",\n   \"en\": \"and on all the days of my lifetime,\"\n  },\n  {\n   \"ar\": \"بِٱلْبَرَاءَةِ مِنْهُمْ وَٱللَّعْنَةِ عَلَيْهِمْ\",\n   \"tr\": \"bilbara'ati minhum walla`nati `alayhim\",\n   \"en\": \"by repudiating these and invoking Your curses upon them,\"\n  },\n  {\n   \"ar\": \"وَبِٱلْمُوَالاَةِ لِنَبِيِّكَ وَآلِ نَبِيِّكَ\",\n   \"tr\": \"wa bilmuwalati linabiyyika wa ali nabiyyika\",\n   \"en\": \"and by declaring loyalty to Your Prophet and Your Prophet’s Household,\"\n  },\n  {\n   \"ar\": \"عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ\",\n   \"tr\": \"`alayhi wa `alayhim alssalamu\",\n   \"en\": \"peace be upon him and them.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱلْعَنْ أَوَّلَ ظَالِمٍ\",\n   \"tr\": \"allahumma il`an awwala zalimin\",\n   \"en\": \"O Allah, pour curses upon the foremost persecutor\"\n  },\n  {\n   \"ar\": \"ظَلَمَ حَقَّ مُحَمَّدٍ وَآلِ مُحَمَّدٍ\",\n   \"tr\": \"zalama haqqa muhammadin wa ali muhammadin\",\n   \"en\": \"who usurped the right of Muhammad and Muhammad’s Household\"\n  },\n  {\n   \"ar\": \"وَآخِرَ تَابِعٍ لَهُ عَلَىٰ ذٰلِكَ\",\n   \"tr\": \"wa akhira tabi`in lahu `ala dhalika\",\n   \"en\": \"and the last follower who acceded to his deed.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱلْعَنِ ٱلْعِصَابَةَ ٱلَّتِي جَاهَدَتِ ٱلْحُسَيْنَ\",\n   \"tr\": \"allahumma il`an al`isabata allati jahadat alhusayna\",\n   \"en\": \"O Allah, pour curses upon the gang that struggled against al-Husayn\"\n  },\n  {\n   \"ar\": \"وَشَايَعَتْ وَبَايَعَتْ وَتَابَعَتْ عَلَىٰ قَتْلِهِ\",\n   \"tr\": \"wa shaya`at wa baya`at wa taba`at `ala qatlihi\",\n   \"en\": \"and who supported each other against him, paid homage to his enemies, and participated in slaying him.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱلْعَنْهُمْ جَمِيعاً\",\n   \"tr\": \"allahumma il`anhum jami`an\",\n   \"en\": \"O Allah, pour curses upon all of them.\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَيْكَ يَا أَبَا عَبْدِ ٱللَّهِ\",\n   \"tr\": \"alssalamu `alayka ya aba `abdillahi\",\n   \"en\": \"Peace be upon you, O Abu-`Abdullah\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ ٱلأَرْوَاحِ ٱلَّتِي حَلَّتْ بِفِنَائِكَ\",\n   \"tr\": \"wa `ala al-arwahi allati hallat bifina'ika\",\n   \"en\": \"and upon the souls that gathered in your courtyard.\"\n  },\n  {\n   \"ar\": \"عَلَيْكَ مِنِّي سَلاَمُ ٱللَّهِ أَبَداً\",\n   \"tr\": \"`alayka minni salamu allahi abadan\",\n   \"en\": \"Peace of Allah be upon you from me forever\"\n  },\n  {\n   \"ar\": \"مَا بَقيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ\",\n   \"tr\": \"ma baqitu wa baqiya allaylu walnnaharu\",\n   \"en\": \"as long as I am existent and as long as there are day and night.\"\n  },\n  {\n   \"ar\": \"وَلاَ جَعَلَهُ ٱللَّهُ آخِرَ ٱلْعَهْدِ مِنِّي لِزِيَارَتِكُمْ\",\n   \"tr\": \"wa la ja`alahu allahu akhira al`ahdi minni liziyaratikum\",\n   \"en\": \"May Allah not cause this (visit) to be the last of my visit to you (all).\"\n  },\n  {\n   \"ar\": \"اَلسَّلاَمُ عَلَىٰ ٱلْحُسَيْنِ\",\n   \"tr\": \"alssalamu `ala alhusayni\",\n   \"en\": \"Peace be upon al-Husayn,\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ عَلِيِّ بْنِ ٱلْحُسَيْنِ\",\n   \"tr\": \"wa `ala `aliyyi bni alhusayni\",\n   \"en\": \"upon `Ali ibn al-Husayn,\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ أَوْلاَدِ ٱلْحُسَيْنِ\",\n   \"tr\": \"wa `ala awladi alhusayni\",\n   \"en\": \"upon the sons of al-Husayn,\"\n  },\n  {\n   \"ar\": \"وَعَلَىٰ أَصْحَابِ ٱلْحُسَيْنِ\",\n   \"tr\": \"wa `ala ashabi alhusayni\",\n   \"en\": \"and upon the companions of al-Husayn.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ خُصَّ أَنْتَ أَوَّلَ ظَالِمٍ بِٱللَّعْنِ مِنِّي\",\n   \"tr\": \"allahumma khussa anta awwala zalimin billa`ni minni\",\n   \"en\": \"O Allah, pour special curses on the foremost persecutor\"\n  },\n  {\n   \"ar\": \"وَٱبْدَأْ بِهِ أَوَّلًا\",\n   \"tr\": \"wabda' bihi awwalan\",\n   \"en\": \"and begin with him first,\"\n  },\n  {\n   \"ar\": \"ثُمَّ ٱلْعَنِ ٱلثَّانِيَ وَٱلثَّالِثَ وَٱلرَّابِعَ\",\n   \"tr\": \"thumma il`an alththaniya walththalitha walrrabi`a\",\n   \"en\": \"and then pour curses on the second, the third, and the fourth.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱلْعَنْ يَزِيدَ خَامِساً\",\n   \"tr\": \"allahumma il`an yazida khamisan\",\n   \"en\": \"O Allah, curse Yazid fifthly,\"\n  },\n  {\n   \"ar\": \"وَٱلْعَنْ عُبَيْدَ ٱللَّهِ بْنَ زِيَادٍ وَٱبْنَ مَرْجَانَةَ\",\n   \"tr\": \"wal`an `ubaydallahi bna ziyadin wabna marjanata\",\n   \"en\": \"and curse `Ubaydullah ibn Ziyad, the son of Marjanah,\"\n  },\n  {\n   \"ar\": \"وَعُمَرَ بْنَ سَعْدٍ وَشِمْراً\",\n   \"tr\": \"wa `umara bna sa`din wa shimran\",\n   \"en\": \"`Umar ibn Sa`d, Shimr,\"\n  },\n  {\n   \"ar\": \"وَآلَ أَبِي سُفْيَانَ وَآلَ زِيَادٍ وَآلَ مَرْوَانَ\",\n   \"tr\": \"wa ala abi sufyana wa ala ziyadin wa ala marwana\",\n   \"en\": \"the family of Abu-Sufyan, the family of Ziyad, and the family of Marwan\"\n  },\n  {\n   \"ar\": \"إِلَىٰ يَوْمِ ٱلْقِيَامَةِ\",\n   \"tr\": \"ila yawmi alqiyamati\",\n   \"en\": \"up to the Resurrection Day.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ لَكَ ٱلْحَمْدُ\",\n   \"tr\": \"allahumma laka alhamdu\",\n   \"en\": \"O Allah, all praise be to You;\"\n  },\n  {\n   \"ar\": \"حَمْدَ ٱلشَّاكِرِينَ لَكَ عَلَىٰ مُصَابِهِمْ\",\n   \"tr\": \"hamda alshshakirina laka `ala musabihim\",\n   \"en\": \"the praise of those who thank You for their misfortunes.\"\n  },\n  {\n   \"ar\": \"اَلْحَمْدُ لِلَّهِ عَلَىٰ عَظِيمِ رَزِيَّتِي\",\n   \"tr\": \"alhamdu lillahi `ala `azimi raziyyati\",\n   \"en\": \"All praise be to Allah for my great misfortune.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱرْزُقْنِي شَفَاعَةَ ٱلْحُسَيْنِ يَوْمَ ٱلْوُرُودِ\",\n   \"tr\": \"allahumma irzuqni shafa`ata alhusayni yawma alwurudi\",\n   \"en\": \"O Allah, (please) grant me the intercession of al-Husayn on the Day of Coming (to You)\"\n  },\n  {\n   \"ar\": \"وَثَبِّتْ لِي قَدَمَ صِدْقٍ عِنْدَكَ\",\n   \"tr\": \"wa thabbit li qadama sidqin `indaka\",\n   \"en\": \"and make for me with You a firm step of honesty\"\n  },\n  {\n   \"ar\": \"مَعَ ٱلْحُسَيْنِ وَأَصْحَابِ ٱلْحُسَيْنِ\",\n   \"tr\": \"ma`a alhusayni wa ashabi alhusayni\",\n   \"en\": \"with al-Husayn and the companions of al-Husayn\"\n  },\n  {\n   \"ar\": \"ٱلَّذينَ بَذَلُوٱ مُهَجَهُمْ دُونَ ٱلْحُسَيْنِ عَلَيْهِ ٱلسَّلاَمُ\",\n   \"tr\": \"alladhina badhalu muhajahum duna alhusayni\",\n   \"en\": \"who sacrificed their souls in defense of al-Husayn, peace be upon him.\"\n  }\n ]\n}"