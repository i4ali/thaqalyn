"{\n \"url\": \"https://www.duas.org/dua-ahad.html\",\n \"title\": \"Dua Ahad - Duas.org\",\n \"meta\": {\n  \"Type\": \"SUPPLICATION\",\n  \"Attributed to\": \"Imam Mahdi (atfs)\",\n  \"Recommended for\": \"Fajr\"\n },\n \"segCount\": 81,\n \"missTR\": 1,\n \"missEN\": 1,\n \"totalArChars\": 3132,\n \"segments\": [\n  {\n   \"ar\": \"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ\",\n   \"tr\": \"\",\n   \"en\": \"\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ رَبَّ ٱلنُّورِ ٱلْعَظِيمِ\",\n   \"tr\": \"allahumma rabba alnnuri al`azimi\",\n   \"en\": \"O Allah the Lord of the Great Light,\"\n  },\n  {\n   \"ar\": \"وَرَبَّ ٱلْكُرْسِيِّ ٱلرَّفِيعِ\",\n   \"tr\": \"wa rabba alkursiyyi alrrafi`i\",\n   \"en\": \"the Lord of the Elevated Throne,\"\n  },\n  {\n   \"ar\": \"وَرَبَّ ٱلْبَحْرِ ٱلْمَسْجُورِ\",\n   \"tr\": \"wa rabba albahri almasjuri\",\n   \"en\": \"the Lord of the swollen ocean,\"\n  },\n  {\n   \"ar\": \"وَمُنْزِلَ ٱلتَّوْرَاةِ وَٱلإِنْجِيلِ وَٱلزَّبُورِ\",\n   \"tr\": \"wa munzila alttawrati wal-injili wallzzaburi\",\n   \"en\": \"the Revealer of the Torah, the Gospel, and the Psalms,\"\n  },\n  {\n   \"ar\": \"وَرَبَّ ٱلظِّلِّ وَٱلْحَرُورِ\",\n   \"tr\": \"wa rabba alzzilli walharuri\",\n   \"en\": \"the Lord of shade and heat,\"\n  },\n  {\n   \"ar\": \"وَمُنْزِلَ ٱلْقُرْآنِ ٱلْعَظِيمِ\",\n   \"tr\": \"wa munzila alqur'ani al`azimi\",\n   \"en\": \"the Revealer of the Great Qur'an,\"\n  },\n  {\n   \"ar\": \"وَرَبَّ ٱلْمَلاَئِكَةِ ٱلْمُقَرَّبِينَ\",\n   \"tr\": \"wa rabba almala'ikati almuqarrabina\",\n   \"en\": \"and the Lord of the Archangels,\"\n  },\n  {\n   \"ar\": \"وَٱلأَنْبِيَاءِ وَٱلْمُرْسَلِينَ\",\n   \"tr\": \"wal-anbiya'i walmursalina\",\n   \"en\": \"the Prophets, and the Messengers:\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ إِنِّي أَسْأَلُكَ بِٱسْمِكَ ٱلْكَرِيـمِ\",\n   \"tr\": \"allahumma inni as'aluka bismika alkarimi\",\n   \"en\": \"O Allah, I beseech You in Your Noble Name,\"\n  },\n  {\n   \"ar\": \"وَبِنُورِ وَجْهِكَ ٱلْمُنِيرِ\",\n   \"tr\": \"wa binuri wajhika almuniri\",\n   \"en\": \"in the Light of Your Luminous Face\"\n  },\n  {\n   \"ar\": \"وَمُلْكِكَ ٱلْقَدِيمِ\",\n   \"tr\": \"wa mulkika alqadimi\",\n   \"en\": \"and Your Eternal Kingdom.\"\n  },\n  {\n   \"ar\": \"يَا حَيُّ يَا قَيُّومُ\",\n   \"tr\": \"ya hayyu ya qayyumu\",\n   \"en\": \"O Ever-living! O Self-Subsistent!\"\n  },\n  {\n   \"ar\": \"أَسْأَلُكَ بِٱسْمِكَ ٱلَّذِي أَشْرَقَتْ بِهِ ٱلسَّمَاوَاتُ وَٱلأَرَضُونَ\",\n   \"tr\": \"as'aluka bismika alladhi ashraqat bihi alssamawatu wal-araduna\",\n   \"en\": \"I beseech You in the name of Your Name with which the heavens and the earth have lit up\"\n  },\n  {\n   \"ar\": \"وَبِٱسْمِكَ ٱلَّذِي يَصْلَحُ بِهِ ٱلأَوَّلُونَ وَٱلآخِرُونَ\",\n   \"tr\": \"wa bismika alladhi yasluhu bihi al-awwaluna wal-akhiruna\",\n   \"en\": \"and in Your Name with which the past and the coming generations have become upright!\"\n  },\n  {\n   \"ar\": \"يَا حَيّاً قَبْلَ كُلِّ حَيٍّ\",\n   \"tr\": \"ya hayyan qabla kulli hayyin\",\n   \"en\": \"O He Who has been always alive before the existence of all living things!\"\n  },\n  {\n   \"ar\": \"وَيَا حَيّاً بَعْدَ كُلِّ حَيٍّ\",\n   \"tr\": \"wa ya hayyan ba`da kulli hayyin\",\n   \"en\": \"O He Who shall be alive after the extinction of all living things!\"\n  },\n  {\n   \"ar\": \"وَيَا حَيّاً حِينَ لا حَيُّ\",\n   \"tr\": \"wa ya hayyan hina la hayyu\",\n   \"en\": \"O He Who has been always alive even when there was nothing else alive!\"\n  },\n  {\n   \"ar\": \"يَا مُحْيِيَ ٱلْمَوْتَىٰ وَمُمِيتَ ٱلأَحْيَاءِ\",\n   \"tr\": \"ya muhyiya almawta wa mumita al-ahya'i\",\n   \"en\": \"O He Who revives the dead ones and causes the living ones to die!\"\n  },\n  {\n   \"ar\": \"يَا حَيُّ لا إِلٰهَ إِلاَّ أَنْتَ\",\n   \"tr\": \"ya hayyu la ilaha illa anta\",\n   \"en\": \"O Ever-living! There is no god save You.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ بَلِّغْ مَوْلاَنَا ٱلإِمَامَ ٱلْهَادِيَ ٱلْمَهْدِيَّ ٱلْقَائِمَ بِأَمْرِكَ\",\n   \"tr\": \"allahumma balligh mawlana al-imama alhadiya almahdiyya alqa'ima bi'amrika\",\n   \"en\": \"O Allah, convey to our master Imam al-Mahdi, the guide who is to undertake Your orders,\"\n  },\n  {\n   \"ar\": \"صَلَوَاتُ ٱللَّهِ عَلَيْهِ وَعَلَىٰ آبَائِهِ ٱلطَّاهِرِينَ\",\n   \"tr\": \"salawatu allahi `alayhi wa `ala aba'ihi alttahirina\",\n   \"en\": \"may Allah’s blessings be upon him and upon his immaculate fathers,\"\n  },\n  {\n   \"ar\": \"عَنْ جَمِيعِ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَاتِ\",\n   \"tr\": \"`an jami`i almu'minina walmu'minati\",\n   \"en\": \"on behalf of all of the believing men and women\"\n  },\n  {\n   \"ar\": \"فِي مَشَارِقِ ٱلأَرْضِ وَمَغَارِبِهَا\",\n   \"tr\": \"fi mashariqi al-ardi wa magharibiha\",\n   \"en\": \"in the east and west of the earth\"\n  },\n  {\n   \"ar\": \"سَهْلِهَا وَجَبَلِهَا\",\n   \"tr\": \"sahliha wa jabaliha\",\n   \"en\": \"and in plains, mountains,\"\n  },\n  {\n   \"ar\": \"وَبَرِّهَا وَبَحْرِهَا\",\n   \"tr\": \"wa barriha wa bahriha\",\n   \"en\": \"lands, and seas,\"\n  },\n  {\n   \"ar\": \"وَعَنِّي وَعَنْ وَالِدَيَّ\",\n   \"tr\": \"wa `anni wa `an walidayya\",\n   \"en\": \"and on behalf of my parents\"\n  },\n  {\n   \"ar\": \"مِنَ ٱلصَّلَوَاتِ زِنَةَ عَرْشِ ٱللَّهِ\",\n   \"tr\": \"min alssalawati zinata `arshi allahi\",\n   \"en\": \"(convey to him) blessings that are as weighty as Allah’s Throne,\"\n  },\n  {\n   \"ar\": \"وَمِدَادَ كَلِمَاتِهِ\",\n   \"tr\": \"wa midada kalimatihi\",\n   \"en\": \"as much as the ink of His Words,\"\n  },\n  {\n   \"ar\": \"وَمَا أَحْصَاهُ عِلْمُهُ وَأَحَاطَ بِهِ كِتَابُهُ\",\n   \"tr\": \"wa ma ahsahu `ilmuhu wa ahata bihi kitabuhu\",\n   \"en\": \"and as many as that which is counted by His knowledge and encompassed by His Book.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ إِنِّي أُجَدِّدُ لَهُ فِي صَبِيحَةِ يَوْمِي هٰذَا\",\n   \"tr\": \"allahumma inni ujaddidu lahu fi sabihati yawmi hadha\",\n   \"en\": \"O Allah, I update to him in the beginning of this day\"\n  },\n  {\n   \"ar\": \"وَمَا عِشْتُ مِنْ أَيَّامِي\",\n   \"tr\": \"wa ma `ishtu min ayyami\",\n   \"en\": \"and throughout the days of lifetime a pledge,\"\n  },\n  {\n   \"ar\": \"عَهْداً وَعَقْداً وَبَيْعَةً لَهُ فِي عُنُقِي\",\n   \"tr\": \"`ahdan wa `aqdan wa bay`atan lahu fi `unuqi\",\n   \"en\": \"a covenant, and allegiance to which I commit myself\"\n  },\n  {\n   \"ar\": \"لا أَحُولُ عنها وَلا أَزُولُ أَبَداً\",\n   \"tr\": \"la ahulu `anhu wa la azulu abadan\",\n   \"en\": \"and from which I neither convert nor change.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱجْعَلْنِي مِنْ أَنْصَارِهِ\",\n   \"tr\": \"allahumma ij`alni min ansarihi\",\n   \"en\": \"O Allah, (please do) make me of his supporters,\"\n  },\n  {\n   \"ar\": \"وَأَعْوَانِهِ وَٱلذَّابِّينَ عَنْهُ\",\n   \"tr\": \"wa a`wanihi waldhdhabbina `anhu\",\n   \"en\": \"sponsors, defenders,\"\n  },\n  {\n   \"ar\": \"وَٱلْمُسَارِعِينَ إِلَيْهِ فِي قَضَاءِ حَوَائِجِهِ\",\n   \"tr\": \"walmusari`ina ilayhi fi qada'i hawa'ijihi\",\n   \"en\": \"and those who hurry in carrying out his instructions,\"\n  },\n  {\n   \"ar\": \"وَٱلْمُمْتَثِلِينَ لأَوَامِرِهِ\",\n   \"tr\": \"walmumtathilina li'awamirihi\",\n   \"en\": \"those who comply with his orders,\"\n  },\n  {\n   \"ar\": \"وَٱلْمُحَامِينَ عَنْهُ\",\n   \"tr\": \"walmuhamina `anhu\",\n   \"en\": \"those who uphold him,\"\n  },\n  {\n   \"ar\": \"وَٱلسَّابِقِينَ إِلَىٰ إِرَادَتِهِ\",\n   \"tr\": \"walssabiqina ila iradatihi\",\n   \"en\": \"those who precede others to implementing his will,\"\n  },\n  {\n   \"ar\": \"وَٱلْمُسْتَشْهَدِينَ بَيْنَ يَدَيْهِ\",\n   \"tr\": \"walmustashhadina bayna yadayhi\",\n   \"en\": \"and those who will be martyred before him.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ إِنْ حَالَ بَيْنِي وَبَيْنَهُ ٱلْمَوْتُ ٱلَّذِي جَعَلْتَهُ عَلَىٰ عِبَادِكَ حَتْماً مَقْضِيّاً\",\n   \"tr\": \"allahumma in hala bayni wa baynahu almawtu alladhi ja`altahu `ala `ibadika hatman maqdiyyan\",\n   \"en\": \"O Allah, if death that You have made inevitably and certainly incumbent upon Your servants stands between me and him,\"\n  },\n  {\n   \"ar\": \"فَأَخْرِجْنِي مِنْ قَبْرِي مُؤْتَزِراً كَفَنِي\",\n   \"tr\": \"fa'akhrijni min qabri mu'taziran kafani\",\n   \"en\": \"then (please do) take me out of my grave using my shroud as dress,\"\n  },\n  {\n   \"ar\": \"شَاهِراً سَيْفِي\",\n   \"tr\": \"sharihan sayfi\",\n   \"en\": \"unsheathing my sword,\"\n  },\n  {\n   \"ar\": \"مُجَرِّداً قَنَاتِي\",\n   \"tr\": \"mujarridan qanati\",\n   \"en\": \"holding my lance in my hand,\"\n  },\n  {\n   \"ar\": \"مُلَبِّياً دَعْوَةَ ٱلدَّاعِي فِي ٱلْحَاضِرِ وَٱلْبَادِي\",\n   \"tr\": \"mulabbiyan da`wata aldda`i filhadiri walbadi\",\n   \"en\": \"and responding to the call of the Caller who shall announce (his advent) in urban areas and deserts.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ أَرِنِي ٱلطَّلْعَةَ ٱلرَّشِيدَةَ\",\n   \"tr\": \"allahumma arini alttal`ata alrrashidata\",\n   \"en\": \"O Allah, (please do) show me his magnificent mien\"\n  },\n  {\n   \"ar\": \"وَٱلْغُرَّةَ ٱلْحَمِيدَةَ\",\n   \"tr\": \"walghurrata alhamidata\",\n   \"en\": \"and his praiseworthy forehead,\"\n  },\n  {\n   \"ar\": \"وَٱكْحُلْ نَاظِرِي بِنَظْرَةٍ مِنِّي إِلَيْهِ\",\n   \"tr\": \"wakhul naziri binazratin minni ilayhi\",\n   \"en\": \"delight my eyes by letting me have a look at him.\"\n  },\n  {\n   \"ar\": \"وَعَجِّلْ فَرَجَهُ\",\n   \"tr\": \"wa `ajjil farajahu\",\n   \"en\": \"And (please) expedite his relief,\"\n  },\n  {\n   \"ar\": \"وَسَهِّلْ مَخْرَجَهُ\",\n   \"tr\": \"wa sahhil makhrajahu\",\n   \"en\": \"make his reappearance easy,\"\n  },\n  {\n   \"ar\": \"وَأَوْسِعْ مَنْهَجَهُ\",\n   \"tr\": \"wa awsi` manhajahu\",\n   \"en\": \"clear a spacious space for him,\"\n  },\n  {\n   \"ar\": \"وَٱسْلُكْ بِي مَحَجَّتَهُ\",\n   \"tr\": \"wasluk bi muhajjatahu\",\n   \"en\": \"guide me to follow his course,\"\n  },\n  {\n   \"ar\": \"وَأَنْفِذْ أَمْرَهُ\",\n   \"tr\": \"wa anfidh amrahu\",\n   \"en\": \"give success to his issues,\"\n  },\n  {\n   \"ar\": \"وَٱشْدُدْ أَزْرَهُ\",\n   \"tr\": \"washdud azrahu\",\n   \"en\": \"and confirm his strength.\"\n  },\n  {\n   \"ar\": \"وَٱعْمُرِ ٱللَّهُمَّ بِهِ بِلادَكَ\",\n   \"tr\": \"wa`mur allahumma bihi biladaka\",\n   \"en\": \"O Allah, construct Your lands through him\"\n  },\n  {\n   \"ar\": \"وَأَحْيِ بِهِ عِبَادَكَ\",\n   \"tr\": \"wa ahyi bihi `ibadaka\",\n   \"en\": \"and refresh Your servants through him,\"\n  },\n  {\n   \"ar\": \"فَإِنَّكَ قُلْتَ وَقَوْلُكَ ٱلْحَقُّ:\",\n   \"tr\": \"fa'innaka qulta wa qawluka alhaqqu\",\n   \"en\": \"For You have said, and true are Your words:\"\n  },\n  {\n   \"ar\": \"«ظَهَرَ ٱلْفَسَادُ فِي ٱلْبَرِّ وَٱلْبَحْرِ\",\n   \"tr\": \"zahara alfasadu filbarri walbahri\",\n   \"en\": \"“Corruption has appeared in the land and the sea\"\n  },\n  {\n   \"ar\": \"بِمَا كَسَبَتْ أَيْدِي ٱلنَّاسِ.»\",\n   \"tr\": \"bima kasabat aydi alnnasi\",\n   \"en\": \"on account of what the hands of men have wrought.”\"\n  },\n  {\n   \"ar\": \"فَأَظْهِرِ ٱللَّهُمَّ لَنَا وَلِيَّكَ\",\n   \"tr\": \"fa'azhir allahumma lana waliyyaka\",\n   \"en\": \"So, O Allah, (please) show us Your vicegerent,\"\n  },\n  {\n   \"ar\": \"وَٱبْنَ بِنْتِ نَبِيِّكَ\",\n   \"tr\": \"wabna binti nabiyyika\",\n   \"en\": \"the son of Your Prophet,\"\n  },\n  {\n   \"ar\": \"ٱلْمُسَمَّىٰ بِٱسْمِ رَسُولِكَ\",\n   \"tr\": \"almusamma bismi rasulika\",\n   \"en\": \"and the namesake of Your Messenger,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"peace be upon him and his Household,\"\n  },\n  {\n   \"ar\": \"حَتَّىٰ لا يَظْفَرَ بِشَيْءٍ مِنَ ٱلْبَاطِلِ إِلاَّ مَزَّقَهُ\",\n   \"tr\": \"hatta la yazfara bishay'in min albatili illa mazzaqahu\",\n   \"en\": \"so that he shall tear up any wrong item that he will face\"\n  },\n  {\n   \"ar\": \"وَيُحِقُّ ٱلْحَقَّ وَيُحَقِّقَهُ وَٱجْعَلْهُ\",\n   \"tr\": \"wa yahiqqa alhaqqa wa yuhaqqiqahu waj`alhu\",\n   \"en\": \"and shall confirm and approve of the truth.\"\n  },\n  {\n   \"ar\": \"ٱللَّهُمَّ مَفْزَعاً لِمَظْلُومِ عِبَادِكَ\",\n   \"tr\": \"allahumma mafza`an limazlumi `ibadika\",\n   \"en\": \"O Allah, (please) make him the shelter to whom Your wronged servants shall resort,\"\n  },\n  {\n   \"ar\": \"وَنَاصِراً لِمَنْ لا يَجِدُ لَهُ نَاصِراً غَيْرَكَ\",\n   \"tr\": \"wa nasiran liman la yajidu lahu nasiran ghayraka\",\n   \"en\": \"the supporter of those who cannot find any supporter save You,\"\n  },\n  {\n   \"ar\": \"وَمُجَدِّداً لِمَا عُطِّلَ مِنْ أَحْكَامِ كِتَابِكَ\",\n   \"tr\": \"wa mujaddidan lima `uttila min ahkami kitabika\",\n   \"en\": \"the reviver of the laws of Your Book that have been suspended,\"\n  },\n  {\n   \"ar\": \"وَمُشَيِّداً لِمَا وَرَدَ مِنْ أَعْلامِ دِينِكَ وَسُنَنِ نَبِيِّكَ\",\n   \"tr\": \"wa mushayyidan lima warada min a`lami dinika wa sunani nabiyyika\",\n   \"en\": \"and the constructor of all signs of Your religion and instructions of Your Messenger,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وآلِهِ وَٱجْعَلْهُ\",\n   \"tr\": \"salla allahu `alayhi wa alihi waj`alhu\",\n   \"en\": \"peace be upon him and his Household, that he will see.\"\n  },\n  {\n   \"ar\": \"ٱللَّهُمَّ مِمَّنْ حَصَّنْتَهُ مِنْ بَأُسِ ٱلْمُعْتَدِينَ\",\n   \"tr\": \"allahumma mimman hassantahu min ba'si almu`tadina\",\n   \"en\": \"O Allah, (please) include him with those whom You protect from the domination of the aggressors.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ وَسُرَّ نَبِيَّكَ مُحَمَّداً\",\n   \"tr\": \"allahumma wa surra nabiyyaka muhammadan\",\n   \"en\": \"O Allah, (please) delight Your Prophet Muhammad,\"\n  },\n  {\n   \"ar\": \"صَلَّىٰ ٱللَّهُ عَلَيْهِ وآلِهِ\",\n   \"tr\": \"salla allahu `alayhi wa alihi\",\n   \"en\": \"peace be upon him and his Household,\"\n  },\n  {\n   \"ar\": \"بِرُؤْيَتِهِ وَمَنْ تَبِعَهُ عَلَىٰ دَعْوَتِهِ\",\n   \"tr\": \"biru'yatihi wa man tabi`ahu `ala da`watihi\",\n   \"en\": \"as well as all those who followed him in his promulgation by making (us) see him,\"\n  },\n  {\n   \"ar\": \"وَٱرْحَمِ ٱسْتِكَانَتَنَا بَعْدَهُ\",\n   \"tr\": \"warham istikanatana ba`dahu\",\n   \"en\": \"and (please) have mercy upon our humiliation after him.\"\n  },\n  {\n   \"ar\": \"اَللَّهُمَّ ٱكْشِفْ هٰذِهِ ٱلْغُمَّةَ عَنْ هٰذِهِ ٱلأُمَّةِ بِحُضُورِهِ\",\n   \"tr\": \"allahumma ikshif hadhihi alghummata `an hadhihi al-ummati bihudurihi\",\n   \"en\": \"O Allah, (please) relieve this community from the (current) grief through presenting him\"\n  },\n  {\n   \"ar\": \"وَعَجِّلْ لَنَا ظُهُورَهُ\",\n   \"tr\": \"wa `ajjil lana zuhurahu\",\n   \"en\": \"and expedite his advent for us:\"\n  },\n  {\n   \"ar\": \"«إِنَّهُمْ يَرَوْنَهُ بَعِيداً وَنَرَاهُ قَرِيباً.»\",\n   \"tr\": \"innahum yarawnahu ba`idan wa narahu qariban\",\n   \"en\": \"“Surely, they think it to be far off, and We see it nigh.”\"\n  },\n  {\n   \"ar\": \"بِرَحْمَتِكَ يَا أَرْحَمَ ٱلرَّاحِمِينَ\",\n   \"tr\": \"birahmatika ya arhama alrrahimina\",\n   \"en\": \"[do all that] In the name of Your mercy; O most merciful of all those who show mercy.\"\n  },\n  {\n   \"ar\": \"الْعَجَلَ ٱلْعَجَلَ يَامَوْلايَ يَا صَاحِبَ ٱلزَّمَانِ\",\n   \"tr\": \"al`ajala al`ajala ya mawlaya ya sahiba alzzaman\",\n   \"en\": \"(We pray for Your) earliest advent, earliest advent, O Patron of the Age.\"\n  }\n ]\n}"